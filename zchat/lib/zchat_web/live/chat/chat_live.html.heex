                    <div class="leading-relaxed break-words">
                      <%= for segment <- message_segments(message.content || "") do %><%= case segment do %><% {:text, text} -> %><%= text %><% {:link, url} -> %><a href={url} target="_blank" rel="noopener noreferrer" class={"font-semibold underline break-all " <> if(is_me, do: "text-white", else: "text-blue-600 dark:text-blue-400")}><%= url %></a><% end %><% end %>
                    </div>

                    <%= if preview_url = first_link(message.content || "") do %>
                      <% preview = Map.get(@link_previews, preview_url) %>
                      <a
                        href={preview_url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class={"mt-2 block overflow-hidden rounded-xl border transition-colors " <>
                          if(is_me,
                            do: "border-white/30 bg-white/10 hover:bg-white/15",
                            else: "border-gray-200 dark:border-zinc-700 bg-white/70 dark:bg-zinc-900/60 hover:bg-white dark:hover:bg-zinc-900")}
