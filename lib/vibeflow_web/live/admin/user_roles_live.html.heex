<div class="container mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold mb-6 text-gray-900 dark:text-white">
    Edit Roles for
    <span class="text-blue-600 inline-flex items-center gap-1">
      {@user.username}
      <.verified_badge user={@user} class="h-5 w-5" />
    </span>
  </h1>

  <div class="bg-white dark:bg-zinc-900 rounded-lg shadow p-6 mb-6 border border-gray-200 dark:border-zinc-800">
    <div class="space-y-4">
      <%= for role <- @all_roles do %>
        <% # Check if the user has this role
        has_role = Enum.any?(@user.roles, fn r -> r.id == role.id end) %>

        <div class="flex items-center p-3 rounded-lg hover:bg-gray-50 dark:hover:bg-zinc-800 transition-colors border border-transparent hover:border-gray-200 dark:hover:border-zinc-700">
          <input
            type="checkbox"
            id={"role_#{role.id}"}
            checked={has_role}
            phx-click="toggle_role"
            phx-value-user_id={@user.id}
            phx-value-role_id={role.id}
            class="h-5 w-5 text-blue-600 focus:ring-blue-500 border-gray-300 rounded cursor-pointer transition-all"
          />

          <label
            for={"role_#{role.id}"}
            class="ml-3 block text-sm font-medium text-gray-700 dark:text-gray-300 cursor-pointer select-none"
          >
            <span class="font-bold">{role.name}</span>
            <%= if Map.has_key?(role, :description) do %>
              - <span class="text-gray-500 font-normal">{role.description}</span>
            <% end %>
          </label>
        </div>
      <% end %>
    </div>

    <div class="mt-8 border-t border-gray-100 dark:border-zinc-800 pt-6">
      <.link
        navigate={~p"/admin/users"}
        class="inline-flex items-center px-4 py-2 bg-gray-100 dark:bg-zinc-800 text-gray-700 dark:text-gray-300 rounded-md hover:bg-gray-200 dark:hover:bg-zinc-700 transition-colors font-medium text-sm"
      >
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 19l-7-7m0 0l7-7m-7 7h18"
          />
        </svg>
        Back to Users
      </.link>
    </div>
  </div>
</div>
