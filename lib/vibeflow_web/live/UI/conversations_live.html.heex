  <div class="max-w-2xl mx-auto p-4">
      <h1 class="text-2xl font-bold mb-6 text-gray-800 dark:text-gray-100">Conversations</h1>

      <div class="space-y-3">
        <%= if Enum.empty?(@conversations) do %>
          <div class="text-center p-10 bg-gray-50 dark:bg-zinc-800 rounded-lg border border-dashed border-gray-300 dark:border-zinc-700">
            <p class="text-gray-500">No conversations yet.</p>
          </div>
        <% else %>
          <%= for conversation <- @conversations do %>
            <!-- Logic to find "The Other Person" -->
<% other_member =
     Enum.find(conversation.conversation_members, fn m ->
       m.user_id != @current_user.id
     end) %>
            <.link
              navigate={~p"/chat/#{conversation.uuid}"}
              class="block p-4 bg-white dark:bg-zinc-800 border border-gray-200 dark:border-zinc-700 rounded-xl shadow-sm hover:shadow-md hover:border-blue-300 transition-all group"
            >
              <div class="flex items-center gap-4">
                <!-- Avatar of the other person -->
                <%= if other_member && other_member.user do %>
                  <img
                    src={other_member.user.avatar_url || "https://ui-avatars.com/api/?name=#{other_member.user.username}"}
                    class="w-12 h-12 rounded-full object-cover border border-gray-100 dark:border-zinc-600"
                  />
                  <div>
                    <p class="font-bold text-gray-900 dark:text-gray-100 group-hover:text-blue-600 dark:group-hover:text-blue-400">
                      <%= other_member.user.username %>
                    </p>
                    <p class="text-sm text-gray-500 dark:text-gray-400">Click to open chat</p>
                  </div>
                <% else %>
                  <!-- Fallback if user data is missing -->
                  <div class="w-12 h-12 rounded-full bg-gray-200 flex items-center justify-center">?</div>
                  <p class="font-bold">Chat #<%= String.slice(conversation.uuid, 0, 8) %></p>
                <% end %>
              </div>
            </.link>
          <% end %>
        <% end %>
      </div>
    </div>