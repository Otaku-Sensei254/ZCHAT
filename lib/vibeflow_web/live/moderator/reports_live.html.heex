<div class="max-w-7xl mx-auto px-4 py-8">
  <%!-- HEADER --%>
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-2">Content Reports</h1>
      <p class="text-gray-600 dark:text-gray-400">Review and manage reported content</p>
    </div>
    <.link navigate={~p"/moderator/dashboard"} class="text-blue-600 dark:text-blue-400 hover:underline text-sm font-medium">
      &larr; Back to Dashboard
    </.link>
  </div>

  <%!-- FILTERS --%>
  <div class="bg-white dark:bg-zinc-900 rounded-2xl shadow-sm border border-gray-100 dark:border-zinc-800 p-4 mb-6">
    <div class="flex flex-wrap gap-3">
      <button class="px-4 py-2 bg-blue-500 text-white text-sm font-medium rounded-lg hover:bg-blue-600 transition-colors">
        All (23)
      </button>
      <button class="px-4 py-2 bg-gray-100 dark:bg-zinc-800 text-gray-700 dark:text-gray-300 text-sm font-medium rounded-lg hover:bg-gray-200 dark:hover:bg-zinc-700 transition-colors">
        High Priority (8)
      </button>
      <button class="px-4 py-2 bg-gray-100 dark:bg-zinc-800 text-gray-700 dark:text-gray-300 text-sm font-medium rounded-lg hover:bg-gray-200 dark:hover:bg-zinc-700 transition-colors">
        Medium Priority (10)
      </button>
      <button class="px-4 py-2 bg-gray-100 dark:bg-zinc-800 text-gray-700 dark:text-gray-300 text-sm font-medium rounded-lg hover:bg-gray-200 dark:hover:bg-zinc-700 transition-colors">
        Low Priority (5)
      </button>
      <button class="px-4 py-2 bg-gray-100 dark:bg-zinc-800 text-gray-700 dark:text-gray-300 text-sm font-medium rounded-lg hover:bg-gray-200 dark:hover:bg-zinc-700 transition-colors">
        Resolved (47)
      </button>
    </div>
  </div>

  <%!-- REPORTS LIST --%>
  <div class="space-y-4">
    <%!-- Report Card 1 --%>
    <div class="bg-white dark:bg-zinc-900 rounded-2xl shadow-sm border border-gray-100 dark:border-zinc-800 overflow-hidden hover:shadow-md transition-shadow">
      <div class="p-6">
        <div class="flex items-start gap-4">
          <%!-- Priority Badge --%>
          <div class="flex-shrink-0">
            <span class="px-3 py-1 bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400 text-xs font-bold rounded-full uppercase">High</span>
          </div>

          <%!-- Content --%>
          <div class="flex-1 min-w-0">
            <div class="flex items-start justify-between gap-4 mb-3">
              <div>
                <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100 mb-1">Spam Content</h3>
                <p class="text-sm text-gray-600 dark:text-gray-400">Report ID: #R2401 • Reported 2 hours ago</p>
              </div>
              <div class="flex gap-2">
                <button class="px-4 py-2 bg-green-500 text-white text-sm font-medium rounded-lg hover:bg-green-600 transition-colors">
                  Approve
                </button>
                <button class="px-4 py-2 bg-red-500 text-white text-sm font-medium rounded-lg hover:bg-red-600 transition-colors">
                  Remove
                </button>
                <button class="px-4 py-2 bg-gray-200 dark:bg-zinc-700 text-gray-700 dark:text-gray-300 text-sm font-medium rounded-lg hover:bg-gray-300 dark:hover:bg-zinc-600 transition-colors">
                  Dismiss
                </button>
              </div>
            </div>

            <div class="bg-gray-50 dark:bg-zinc-800 rounded-lg p-4 mb-3">
              <p class="text-sm text-gray-700 dark:text-gray-300 mb-2"><strong>Reported by:</strong> @johndoe</p>
              <p class="text-sm text-gray-700 dark:text-gray-300 mb-2"><strong>Content author:</strong> @spammer123</p>
              <p class="text-sm text-gray-700 dark:text-gray-300"><strong>Reason:</strong> Post contains promotional links and spam content violating community guidelines</p>
            </div>

            <div class="bg-blue-50 dark:bg-blue-900/20 rounded-lg p-4 border border-blue-200 dark:border-blue-800">
              <p class="text-sm text-gray-800 dark:text-gray-200 italic">"🎉 Click here to win $1000! Limited time offer! Visit www.scam-site.com now! 💰💰💰"</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%!-- Report Card 2 --%>
    <div class="bg-white dark:bg-zinc-900 rounded-2xl shadow-sm border border-gray-100 dark:border-zinc-800 overflow-hidden hover:shadow-md transition-shadow">
      <div class="p-6">
        <div class="flex items-start gap-4">
          <div class="flex-shrink-0">
            <span class="px-3 py-1 bg-indigo-100 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-400 text-xs font-bold rounded-full uppercase">Medium</span>
          </div>

          <div class="flex-1 min-w-0">
            <div class="flex items-start justify-between gap-4 mb-3">
              <div>
                <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100 mb-1">Hate Speech</h3>
                <p class="text-sm text-gray-600 dark:text-gray-400">Report ID: #R2400 • Reported 4 hours ago</p>
              </div>
              <div class="flex gap-2">
                <button class="px-4 py-2 bg-green-500 text-white text-sm font-medium rounded-lg hover:bg-green-600 transition-colors">
                  Approve
                </button>
                <button class="px-4 py-2 bg-red-500 text-white text-sm font-medium rounded-lg hover:bg-red-600 transition-colors">
                  Remove
                </button>
                <button class="px-4 py-2 bg-gray-200 dark:bg-zinc-700 text-gray-700 dark:text-gray-300 text-sm font-medium rounded-lg hover:bg-gray-300 dark:hover:bg-zinc-600 transition-colors">
                  Dismiss
                </button>
              </div>
            </div>

            <div class="bg-gray-50 dark:bg-zinc-800 rounded-lg p-4 mb-3">
              <p class="text-sm text-gray-700 dark:text-gray-300 mb-2"><strong>Reported by:</strong> @sarahsmith</p>
              <p class="text-sm text-gray-700 dark:text-gray-300 mb-2"><strong>Content author:</strong> @angryuser</p>
              <p class="text-sm text-gray-700 dark:text-gray-300"><strong>Reason:</strong> Comment contains offensive language targeting specific groups</p>
            </div>

            <div class="bg-blue-50 dark:bg-blue-900/20 rounded-lg p-4 border border-blue-200 dark:border-blue-800">
              <p class="text-sm text-gray-800 dark:text-gray-200 italic">"[Offensive content removed by moderator for display purposes]"</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%!-- Report Card 3 --%>
    <div class="bg-white dark:bg-zinc-900 rounded-2xl shadow-sm border border-gray-100 dark:border-zinc-800 overflow-hidden hover:shadow-md transition-shadow">
      <div class="p-6">
        <div class="flex items-start gap-4">
          <div class="flex-shrink-0">
            <span class="px-3 py-1 bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-400 text-xs font-bold rounded-full uppercase">Low</span>
          </div>

          <div class="flex-1 min-w-0">
            <div class="flex items-start justify-between gap-4 mb-3">
              <div>
                <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100 mb-1">Misinformation</h3>
                <p class="text-sm text-gray-600 dark:text-gray-400">Report ID: #R2399 • Reported 6 hours ago</p>
              </div>
              <div class="flex gap-2">
                <button class="px-4 py-2 bg-green-500 text-white text-sm font-medium rounded-lg hover:bg-green-600 transition-colors">
                  Approve
                </button>
                <button class="px-4 py-2 bg-red-500 text-white text-sm font-medium rounded-lg hover:bg-red-600 transition-colors">
                  Remove
                </button>
                <button class="px-4 py-2 bg-gray-200 dark:bg-zinc-700 text-gray-700 dark:text-gray-300 text-sm font-medium rounded-lg hover:bg-gray-300 dark:hover:bg-zinc-600 transition-colors">
                  Dismiss
                </button>
              </div>
            </div>

            <div class="bg-gray-50 dark:bg-zinc-800 rounded-lg p-4 mb-3">
              <p class="text-sm text-gray-700 dark:text-gray-300 mb-2"><strong>Reported by:</strong> @mikebrown</p>
              <p class="text-sm text-gray-700 dark:text-gray-300 mb-2"><strong>Content author:</strong> @healthguru99</p>
              <p class="text-sm text-gray-700 dark:text-gray-300"><strong>Reason:</strong> Post contains false health claims without scientific backing</p>
            </div>

            <div class="bg-blue-50 dark:bg-blue-900/20 rounded-lg p-4 border border-blue-200 dark:border-blue-800">
              <p class="text-sm text-gray-800 dark:text-gray-200 italic">"Drinking 10 glasses of lemon water daily cures all diseases! No need for doctors anymore!"</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%!-- Report Card 4 --%>
    <div class="bg-white dark:bg-zinc-900 rounded-2xl shadow-sm border border-gray-100 dark:border-zinc-800 overflow-hidden hover:shadow-md transition-shadow">
      <div class="p-6">
        <div class="flex items-start gap-4">
          <div class="flex-shrink-0">
            <span class="px-3 py-1 bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400 text-xs font-bold rounded-full uppercase">High</span>
          </div>

          <div class="flex-1 min-w-0">
            <div class="flex items-start justify-between gap-4 mb-3">
              <div>
                <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100 mb-1">Harassment</h3>
                <p class="text-sm text-gray-600 dark:text-gray-400">Report ID: #R2398 • Reported 8 hours ago</p>
              </div>
              <div class="flex gap-2">
                <button class="px-4 py-2 bg-green-500 text-white text-sm font-medium rounded-lg hover:bg-green-600 transition-colors">
                  Approve
                </button>
                <button class="px-4 py-2 bg-red-500 text-white text-sm font-medium rounded-lg hover:bg-red-600 transition-colors">
                  Remove
                </button>
                <button class="px-4 py-2 bg-gray-200 dark:bg-zinc-700 text-gray-700 dark:text-gray-300 text-sm font-medium rounded-lg hover:bg-gray-300 dark:hover:bg-zinc-600 transition-colors">
                  Dismiss
                </button>
              </div>
            </div>

            <div class="bg-gray-50 dark:bg-zinc-800 rounded-lg p-4 mb-3">
              <p class="text-sm text-gray-700 dark:text-gray-300 mb-2"><strong>Reported by:</strong> @emilyjones</p>
              <p class="text-sm text-gray-700 dark:text-gray-300 mb-2"><strong>Content author:</strong> @bully456</p>
              <p class="text-sm text-gray-700 dark:text-gray-300"><strong>Reason:</strong> User is being targeted repeatedly with malicious comments</p>
            </div>

            <div class="bg-blue-50 dark:bg-blue-900/20 rounded-lg p-4 border border-blue-200 dark:border-blue-800">
              <p class="text-sm text-gray-800 dark:text-gray-200 italic">"@emilyjones You're pathetic. Nobody wants you here. Why don't you just leave already?"</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%!-- PAGINATION --%>
  <div class="mt-8 flex items-center justify-between">
    <p class="text-sm text-gray-600 dark:text-gray-400">Showing 4 of 23 reports</p>
    <div class="flex gap-2">
      <button class="px-4 py-2 bg-gray-200 dark:bg-zinc-800 text-gray-700 dark:text-gray-300 text-sm font-medium rounded-lg hover:bg-gray-300 dark:hover:bg-zinc-700 transition-colors disabled:opacity-50" disabled>
        Previous
      </button>
      <button class="px-4 py-2 bg-blue-500 text-white text-sm font-medium rounded-lg hover:bg-blue-600 transition-colors">
        Next
      </button>
    </div>
  </div>
</div>