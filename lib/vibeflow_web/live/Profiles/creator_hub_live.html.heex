<div class="max-w-7xl mx-auto px-4 lg:px-6 py-6">
  <div class="rounded-3xl overflow-hidden border border-slate-200/60 dark:border-zinc-800 bg-gradient-to-br from-white via-slate-50 to-blue-50/60 dark:from-zinc-900 dark:via-zinc-900 dark:to-zinc-900/60">
    <div class="p-6 lg:p-8 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
      <div>
        <.link navigate={~p"/users/#{@user.username}"} class="text-xs text-blue-600 dark:text-blue-400 hover:underline">
          &larr; Back to profile
        </.link>
        <h1 class="text-3xl lg:text-4xl font-extrabold text-gray-900 dark:text-white tracking-tight mt-2">
          Creator Hub
        </h1>
        <p class="text-sm text-gray-600 dark:text-gray-300 mt-1">
          Track how your posts ripple through the network.
        </p>
      </div>
      <div class="flex items-center gap-3 bg-white/80 dark:bg-zinc-800/70 border border-slate-200 dark:border-zinc-700 rounded-2xl px-4 py-3 shadow-sm">
        <img src={@user.avatar_url || "/images/default_avatar.png"} class="w-10 h-10 rounded-full object-cover border border-gray-200 dark:border-zinc-700">
        <div>
          <div class="font-semibold text-gray-900 dark:text-white flex items-center gap-1">
            <%= @user.username %>
            <.verified_badge user={@user} class="h-5 w-5" />
          </div>
          <div class="text-xs text-gray-500 dark:text-gray-400">Creator dashboard</div>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-2 lg:grid-cols-5 gap-3 mt-6">
    <div class="rounded-2xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-4">
      <div class="text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400">Views</div>
      <div class="text-2xl font-bold text-gray-900 dark:text-white mt-2"><%= @totals.views %></div>
    </div>
    <div class="rounded-2xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-4">
      <div class="text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400">Likes</div>
      <div class="text-2xl font-bold text-gray-900 dark:text-white mt-2"><%= @totals.likes %></div>
    </div>
    <div class="rounded-2xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-4">
      <div class="text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400">Comments</div>
      <div class="text-2xl font-bold text-gray-900 dark:text-white mt-2"><%= @totals.comments %></div>
    </div>
    <div class="rounded-2xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-4">
      <div class="text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400">Reach</div>
      <div class="text-2xl font-bold text-gray-900 dark:text-white mt-2"><%= @totals.reach %></div>
    </div>
    <div class="rounded-2xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-4">
      <div class="text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400">Rippled</div>
      <div class="text-2xl font-bold text-gray-900 dark:text-white mt-2"><%= @totals.rippled %></div>
    </div>
  </div>

  <div class="mt-8">
    <h2 class="text-lg font-bold text-gray-900 dark:text-white mb-4">Post Trail</h2>

    <%= if @posts == [] do %>
      <div class="text-sm text-gray-500 dark:text-gray-400">No posts yet.</div>
    <% else %>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <%= for p <- @posts do %>
          <div class="rounded-3xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-5 shadow-sm">
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <h3 class="font-semibold text-gray-900 dark:text-white truncate">
                  <%= p.post.title || "Untitled Post" %>
                </h3>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
                  <%= Timex.from_now(p.post.inserted_at) %>
                </p>
              </div>
              <.link navigate={~p"/posts/#{p.post.uuid}"} class="text-xs text-blue-600 dark:text-blue-400 hover:underline">
                View
              </.link>
            </div>

            <div class="grid grid-cols-3 gap-3 mt-4">
              <div class="rounded-xl bg-slate-50 dark:bg-zinc-800 p-3 text-center">
                <div class="text-xs text-gray-500 dark:text-gray-400">Views</div>
                <div class="font-bold text-gray-900 dark:text-white"><%= p.post.view_count || 0 %></div>
              </div>
              <div class="rounded-xl bg-slate-50 dark:bg-zinc-800 p-3 text-center">
                <div class="text-xs text-gray-500 dark:text-gray-400">Likes</div>
                <div class="font-bold text-gray-900 dark:text-white"><%= p.likes_count %></div>
              </div>
              <div class="rounded-xl bg-slate-50 dark:bg-zinc-800 p-3 text-center">
                <div class="text-xs text-gray-500 dark:text-gray-400">Comments</div>
                <div class="font-bold text-gray-900 dark:text-white"><%= p.comments_count %></div>
              </div>
            </div>

            <div class="mt-4 grid grid-cols-3 gap-3">
              <div class="rounded-xl border border-slate-200 dark:border-zinc-700 p-3 text-center">
                <div class="text-xs text-gray-500 dark:text-gray-400">Seeded</div>
                <div class="font-bold text-gray-900 dark:text-white"><%= p.seed_count %></div>
              </div>
              <div class="rounded-xl border border-slate-200 dark:border-zinc-700 p-3 text-center">
                <div class="text-xs text-gray-500 dark:text-gray-400">Rippled</div>
                <div class="font-bold text-gray-900 dark:text-white"><%= p.rippled_count %></div>
              </div>
              <div class="rounded-xl border border-slate-200 dark:border-zinc-700 p-3 text-center">
                <div class="text-xs text-gray-500 dark:text-gray-400">Stopped At</div>
                <div class="font-bold text-gray-900 dark:text-white"><%= p.frontier_count %></div>
              </div>
            </div>

            <div class="mt-4">
              <div class="text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-2">
                Ripple Trail (Who Shared)
              </div>
              <div class="flex flex-wrap gap-2">
                <%= if p.ripplers == [] do %>
                  <span class="text-xs text-gray-400">No ripples yet</span>
                <% else %>
                  <%= for u <- p.ripplers do %>
                    <span class="text-xs px-2.5 py-1 rounded-full bg-blue-50 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300 border border-blue-100 dark:border-blue-800">
                      <%= u.username %>
                    </span>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
