<div class="max-w-4xl mx-auto py-8 px-4 sm:px-6">
  <h1 class="text-3xl font-bold mb-8 text-gray-900 dark:text-white">
    User Role Management
  </h1>

  <div class="mb-8">
    <form phx-change="search" phx-submit="search" onsubmit="return false;">
      <div class="relative">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <svg class="h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        
        <input
          type="text"
          name="query"
          value={@search_query}
          placeholder="Search by username..."
          phx-debounce="300"
          class="block w-full pl-10 pr-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg leading-5 bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 sm:text-sm transition duration-150 ease-in-out shadow-sm"
        />
        
        <div class="absolute inset-y-0 right-0 pr-3 flex items-center">
          <div class="h-4 w-4 text-blue-500 animate-spin hidden" id="search-loading" phx-update="ignore">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </div>
        </div>
      </div>
    </form>
  </div>

  <div class="space-y-6">
    <%= for user <- @users do %>
      <div class="bg-white dark:bg-zinc-900 p-6 rounded-xl shadow-md border border-gray-200 dark:border-zinc-800 group transition-all hover:shadow-lg">
        <div class="flex flex-col md:flex-row justify-between items-center gap-6">
          
          <div class="flex flex-col md:flex-row items-center text-center md:text-left gap-4">
            <div class="relative shrink-0">
              <%= if user.avatar_url do %>
                <img
                  src={user.avatar_url}
                  alt={user.username}
                  class="w-20 h-20 rounded-full object-cover border-4 border-white dark:border-zinc-700 shadow-sm transition-transform duration-300 group-hover:scale-105"
                />
              <% else %>
                <div class="w-20 h-20 rounded-full bg-gradient-to-br from-indigo-100 to-indigo-200 dark:from-indigo-900 dark:to-indigo-900/50 text-indigo-600 dark:text-indigo-200 flex items-center justify-center border-4 border-white dark:border-zinc-700 shadow-sm">
                  <span class="text-2xl font-bold uppercase">
                    <%= String.slice(user.username || "U", 0, 2) %>
                  </span>
                </div>
              <% end %>
            </div>
            
            <div>
              <h2 class="text-xl font-semibold text-gray-900 dark:text-white flex items-center gap-1">
                <%= user.username %>
                <.verified_badge user={user} class="h-5 w-5" />
              </h2>
              <p class="text-sm text-gray-500 dark:text-gray-400 break-all">
                <%= user.email %>
              </p>
            </div>
          </div>

          <div class="w-full md:w-auto flex flex-col items-center md:items-end gap-2">
            <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">
              Manage Access
            </h3>
            
            <div class="flex flex-wrap justify-center md:justify-end gap-2">
              <%= for role <- @all_roles do %>
                <% 
                  # Check if user has this role
                  has_role = Enum.any?(user.roles, fn r -> r.id == role.id end) 
                %>

                <button
                  phx-click="update_user_roles"
                  phx-value-user_id={user.id}
                  phx-value-role_id={role.id}
                  class={[
                    "inline-flex items-center px-3 py-1.5 rounded-full text-xs font-semibold border transition-all duration-200",
                    has_role && "bg-blue-100 text-blue-700 border-blue-200 hover:bg-red-100 hover:text-red-700 hover:border-red-200 dark:bg-blue-900/40 dark:text-blue-300 dark:border-blue-800 dark:hover:bg-red-900/40 dark:hover:text-red-300" || "bg-gray-50 text-gray-600 border-gray-200 hover:bg-blue-50 hover:text-blue-600 hover:border-blue-200 dark:bg-zinc-800 dark:text-gray-400 dark:border-zinc-700 dark:hover:bg-blue-900/30 dark:hover:text-blue-300"
                  ]}
                >
                  <span><%= role.name %></span>

                  <%= if has_role do %>
                    <svg class="ml-1.5 w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
                  <% else %>
                    <svg class="ml-1.5 w-3 h-3 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M12 4v16m8-8H4" /></svg>
                  <% end %>
                </button>
              <% end %>
            </div>
          </div>

        </div>
      </div>
    <% end %>
  </div>
</div>
