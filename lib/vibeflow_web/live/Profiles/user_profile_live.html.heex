<div class="max-w-5xl mx-auto py-8 px-4">
  <%!-- TOP NAVIGATION --%>
  <div class="flex items-center justify-between mb-6">
    <.link
      navigate={~p"/feed"}
      class="flex items-center gap-2 text-sm font-semibold text-gray-500 hover:text-indigo-500 transition-colors group"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-4 w-4 group-hover:-translate-x-1 transition-transform"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      Back to Feed
    </.link>

    <%!-- ROLE-BASED DASHBOARD BUTTONS --%>
    <%= if @current_user && @current_user.roles do %>
      <div class="flex flex-col md:flex-row gap-3">
        <%!-- Admin Dashboard Button --%>
        <%= if Enum.any?(@current_user.roles, &(&1.name == "admin")) do %>
          <.link
            navigate={~p"/admin/dashboard"}
            class="flex items-center gap-2 px-5 py-2.5 bg-indigo-500 text-white text-xs font-bold uppercase tracking-wide rounded-full shadow-lg shadow-indigo-500/30 hover:bg-indigo-600 hover:shadow-indigo-500/50 transition-all transform hover:scale-105"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
              />
            </svg>
            Admin Dashboard
          </.link>
        <% end %>

        <%!-- Moderator Dashboard Button --%>
        <%= if Enum.any?(@current_user.roles, &(&1.name == "moderator")) do %>
          <.link
            navigate={~p"/moderator/dashboard"}
            class="flex items-center gap-2 px-5 py-2.5 bg-blue-500 text-white text-xs font-bold uppercase tracking-wide rounded-full shadow-lg shadow-blue-500/30 hover:bg-blue-600 hover:shadow-blue-500/50 transition-all transform hover:scale-105"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
              />
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
              />
            </svg>
            Moderator Dashboard
          </.link>
        <% end %>

        <%!-- Sales Executive Dashboard Button --%>
        <%= if Enum.any?(@current_user.roles, &(&1.name == "sales_executive")) do %>
          <.link
            navigate={~p"/sales-executive/dashboard"}
            class="flex items-center gap-2 px-5 py-2.5 bg-green-500 text-white text-xs font-bold uppercase tracking-wide rounded-full shadow-lg shadow-green-500/30 hover:bg-green-600 hover:shadow-green-500/50 transition-all transform hover:scale-105"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              />
            </svg>
            Sales Dashboard
          </.link>
        <% end %>
      </div>
    <% end %>
  </div>

  <%!-- PROFILE CARD CONTAINER --%>
  <%!-- This creates the main white card with the subtle indigo glow effect --%>
  <div class="bg-white dark:bg-zinc-900 rounded-3xl shadow-xl shadow-gray-200/50 dark:shadow-none border border-gray-100 dark:border-zinc-800 p-6 md:p-10 mb-12 relative overflow-hidden">
    <%!-- The decorative glow blob --%>
    <div class="absolute top-0 right-0 -mt-10 -mr-10 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none">
    </div>

    <div class="relative z-10 flex flex-col md:flex-row md:items-start justify-between gap-8">
      <%!-- LEFT: User Info --%>
      <div class="flex-1">
        <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 text-center sm:text-left">
          <%!-- Avatar with Ring --%>
          <div class="relative group">
            <%= if @user.avatar_url do %>
            <div class="w-32 h-32 md:w-40 md:h-40 shrink-0">
              <img
                src={@user.avatar_url}
                alt={@user.username}
                class="w-full h-full rounded-full object-cover border-4 border-white dark:border-zinc-800 shadow-lg group-hover:scale-105 transition-transform duration-300"
              />
            </div>
            <% else %>
              <div class="w-32 h-32 md:w-40 md:h-40 rounded-full bg-gradient-to-br from-indigo-100 to-indigo-200 text-indigo-600 dark:from-indigo-900 dark:to-zinc-800 dark:text-indigo-400 flex items-center justify-center font-bold text-5xl md:text-6xl border-4 border-white dark:border-zinc-800 shadow-lg">
                <%= VibeflowWeb.CoreComponents.initials(@user) %>
              </div>
              <%= if @current_user && @current_user.id == @user.id do %>
                <div class="absolute -bottom-2 -right-2 bg-amber-500 text-white rounded-full p-2 shadow-lg animate-pulse">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                  </svg>
                </div>
                <.link navigate={~p"/users/settings"} class="absolute inset-0 flex items-center justify-center bg-black/50 rounded-full opacity-0 group-hover:opacity-100 transition-opacity">
                  <div class="text-white text-center">
                    <svg class="w-6 h-6 mx-auto mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    <p class="text-xs">Add Photo</p>
                  </div>
                </.link>
              <% end %>
            <% end %>
          </div>

          <%!-- Name & Handle --%>
          <div class="pt-2">
            <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 dark:text-gray-100 tracking-tight flex items-center gap-2 justify-center sm:justify-start">
              <span><%= @user.username %></span>
              <.verified_badge user={@user} class="h-5 w-5" />
            </h1>

            <div class="flex items-center justify-center sm:justify-start gap-3 mt-2">
              <span class="px-3 py-1 bg-gray-100 dark:bg-zinc-800 text-gray-600 dark:text-gray-400 rounded-full text-xs font-medium flex items-center gap-1">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-3 w-3"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                  />
                </svg>
                Since <%= Timex.format!(@user.inserted_at, "%b %Y", :strftime) %>
              </span>

              <%!-- Roles Badges --%>
              <%= if @current_user && @current_user.id == @user.id && @user.roles do %>
                <%= for role <- @user.roles do %>
                  <span class="px-3 py-1 text-xs font-bold uppercase tracking-wider text-blue-600 bg-blue-50 rounded-full dark:bg-blue-900/30 dark:text-blue-300 border border-blue-100 dark:border-blue-800">
                    <%= role.name %>
                  </span>
                <% end %>
              <% end %>
            </div>

            <%= if @user.bio do %>
              <p class="text-gray-600 dark:text-gray-300 text-sm mt-4 max-w-lg leading-relaxed">
                <%= linkify_bio(@user.bio) %>
              </p>
            <% else %>
              <div class="mt-4 p-4 bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-lg">
                <div class="flex items-center gap-3">
                  <div class="flex-shrink-0">
                    <svg class="w-5 h-5 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                  </div>
                  <div class="flex-1">
                    <p class="text-sm text-amber-800 dark:text-amber-200">
                      No bio added yet
                    </p>
                    <%= if @current_user && @current_user.id == @user.id do %>
                      <.link navigate={~p"/users/settings"} class="text-sm text-amber-600 dark:text-amber-400 hover:underline font-medium">
                        Add your bio →
                      </.link>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>

            <%= if Enum.any?(@user.social_accounts || []) do %>
              <div class="mt-4 flex flex-wrap gap-4">
                <%= for social <- @user.social_accounts do %>
                  <a
                    href={social.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    title={String.upcase(social.platform)}
                    class="inline-flex flex-col items-center justify-center gap-2"
                  >
                    <span class="inline-flex items-center justify-center w-10 h-10 rounded-full border border-gray-200 bg-gray-50 text-gray-700 hover:bg-white hover:border-gray-300 transition-colors dark:bg-zinc-800 dark:text-gray-200 dark:border-zinc-700 dark:hover:border-zinc-600">
                      <%= case social.platform do %>
                        <% "youtube" -> %>
                          <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
                          <path d="M23.5 6.2a3.1 3.1 0 0 0-2.2-2.2C19.3 3.5 12 3.5 12 3.5s-7.3 0-9.3.5A3.1 3.1 0 0 0 .5 6.2 32.7 32.7 0 0 0 0 12a32.7 32.7 0 0 0 .5 5.8 3.1 3.1 0 0 0 2.2 2.2c2 .5 9.3.5 9.3.5s7.3 0 9.3-.5a3.1 3.1 0 0 0 2.2-2.2A32.7 32.7 0 0 0 24 12a32.7 32.7 0 0 0-.5-5.8zM9.6 15.5V8.5l6.4 3.5-6.4 3.5z"/>
                          </svg>
                        <% "instagram" -> %>
                          <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
                          <path d="M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4zm10 2H7a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2zm-5 3.5a3.5 3.5 0 1 1 0 7 3.5 3.5 0 0 1 0-7zm5.3-.8a1 1 0 1 1-2 0 1 1 0 0 1 2 0z"/>
                          </svg>
                        <% "x" -> %>
                          <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
                          <path d="M18.9 2H22l-7.2 8.2L23 22h-6.6l-5.2-6.8L4.7 22H1.6l7.7-8.8L1 2h6.7l4.7 6.2L18.9 2zm-1.2 18h1.8L7.2 4H5.3l12.4 16z"/>
                          </svg>
                        <% "twitch" -> %>
                          <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
                          <path d="M4 3h16v10l-4 4h-4l-2 2H8v-2H4V3zm2 2v10h4v2l2-2h4l2-2V5H6zm5 3h2v4h-2V8zm4 0h2v4h-2V8z"/>
                          </svg>
                        <% "tiktok" -> %>
                          <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
                          <path d="M15 3c.5 2.1 2.1 3.7 4.2 4.1V10a7.1 7.1 0 0 1-4.2-1.5v7.1a5.6 5.6 0 1 1-5.6-5.6c.4 0 .8 0 1.1.1v2.9a2.6 2.6 0 1 0 2.5 2.6V3h2z"/>
                          </svg>
                        <% "discord" -> %>
                          <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
                          <path d="M20 5.3A16 16 0 0 0 15.9 4l-.2.5a14 14 0 0 1 3.5 1.3 13 13 0 0 0-9.4 0A14 14 0 0 1 13.3 4l-.2-.5A16 16 0 0 0 4 5.3a16.9 16.9 0 0 0-2 11.3 16 16 0 0 0 4.9 2.5l1-1.6a10.6 10.6 0 0 1-2.2-1.1c.2.1.4.3.6.4a12.1 12.1 0 0 0 11.4 0l.6-.4c-.7.4-1.4.8-2.2 1.1l1 1.6a16 16 0 0 0 4.9-2.5A16.9 16.9 0 0 0 20 5.3zM9.4 14.3c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2zm5.2 0c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2z"/>
                          </svg>
                        <% _ -> %>
                          <span class="text-xs font-bold uppercase"><%= String.first(social.platform || "?") %></span>
                      <% end %>
                    </span>
                    <span class="text-[11px] font-semibold text-gray-600 dark:text-gray-400 max-w-[80px] truncate">
                      <%= social.username %>
                    </span>
                  </a>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>

        <%!-- Stats Row (Pills) --%>
        <div class="flex justify-center sm:justify-start gap-4 mt-8">
          <div class="px-6 py-3 bg-gray-50 dark:bg-zinc-800 rounded-2xl border border-gray-100 dark:border-zinc-700 text-center min-w-[90px]">
            <span class="block font-black text-xl text-gray-900 dark:text-white">
              <%= length(@posts) %>
            </span>
            <span class="text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
              Posts
            </span>
          </div>
          
          <div class="px-6 py-3 bg-gray-50 dark:bg-zinc-800 rounded-2xl border border-gray-100 dark:border-zinc-700 text-center min-w-[90px] cursor-pointer hover:bg-gray-100 dark:hover:bg-zinc-700 transition-colors" phx-click="show_followers">
            <span class="block font-black text-xl text-gray-900 dark:text-white">
              <%= @follow_stats.followers_count %>
            </span>
            <span class="text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
              Followers
            </span>
          </div>
          
          <div class="px-6 py-3 bg-gray-50 dark:bg-zinc-800 rounded-2xl border border-gray-100 dark:border-zinc-700 text-center min-w-[90px] cursor-pointer hover:bg-gray-100 dark:hover:bg-zinc-700 transition-colors" phx-click="show_following">
            <span class="block font-black text-xl text-gray-900 dark:text-white">
              <%= @follow_stats.following_count %>
            </span>
            <span class="text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
              Following
            </span>
          </div>
        </div>

              </div>

      <%!-- Wave Store Button --%>
      <div class="mt-4 md:mt-0"> 
        <.link navigate={~p"/wave-store"} class="group relative flex items-center gap-3 px-6 py-3 bg-gradient-to-br from-indigo-600 to-purple-700 text-white rounded-2xl shadow-[0_10px_25px_-5px_rgba(79,70,229,0.4)] hover:shadow-[0_15px_30px_-5px_rgba(79,70,229,0.6)] transition-all duration-300 transform hover:-translate-y-1 active:scale-95 overflow-hidden">
          <%!-- Background glow effect --%>
          <div class="absolute inset-0 bg-white/10 opacity-0 group-hover:opacity-100 transition-opacity"></div>
          
          <%!-- Icon with accent --%>
          <div class="relative flex items-center justify-center w-10 h-10 bg-white/20 rounded-xl backdrop-blur-sm group-hover:rotate-12 transition-transform duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
              <path fill-rule="evenodd" d="M7.5 6v.75H5.513c-.96 0-1.764.724-1.86 1.679l-1.263 12A1.875 1.875 0 0 0 4.25 22.5h15.5a1.875 1.875 0 0 0 1.86-2.071l-1.263-12a1.875 1.875 0 0 0-1.86-1.679H16.5V6a4.5 4.5 0 1 0-9 0ZM12 3a3 3 0 0 0-3 3v.75h6V6a3 3 0 0 0-3-3Zm-3 8.25a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Zm7.5.75a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" clip-rule="evenodd" />
            </svg>
            <div class="absolute -top-1 -right-1 w-3 h-3 bg-yellow-400 rounded-full border-2 border-indigo-600 animate-pulse shadow-sm"></div>
          </div>

          <div class="flex flex-col items-start leading-tight">
            <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-indigo-100/80">Exciting </span>
            <span class="text-base font-black tracking-wide">Wave Store</span>
          </div>

          <%!-- Subtle Shimmer --%>
          <div class="absolute inset-0 translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-1000 bg-gradient-to-r from-transparent via-white/20 to-transparent pointer-events-none"></div>
        </.link>
      </div>

      <div class="flex flex-row md:flex-col gap-3 justify-center w-full md:w-auto mt-6 md:mt-2">
        <%= if @current_user.id == @user.id do %>
          <.link
            navigate={~p"/users/settings"}
            class="w-full md:w-40 px-6 py-2.5 bg-white hover:bg-gray-50 text-gray-700 font-bold rounded-full text-sm border-2 border-gray-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 dark:text-white dark:border-zinc-700 shadow-sm transition-all hover:shadow-md text-center"
          >
            Edit Profile
          </.link>
          <%= if Enum.empty?(@user.social_accounts || []) do %>
            <button
              phx-click="open_verification_modal"
              class="w-full md:w-40 px-6 py-2.5 bg-indigo-50 text-indigo-700 font-bold rounded-full text-sm border-2 border-indigo-100 hover:bg-indigo-100 transition-all dark:bg-indigo-900/30 dark:text-indigo-200 dark:border-indigo-800"
            >
              Add Socials
            </button>
          <% end %>
          <%= if @user.is_verified do %>
            <%!-- User is verified - no button shown --%>
          <% else %>
            <%= if @pending_verification do %>
              <div class="w-full md:w-40 px-6 py-2.5 bg-gray-100 text-gray-500 font-bold rounded-full text-sm text-center border-2 border-gray-200 cursor-not-allowed dark:bg-zinc-800 dark:text-zinc-500 dark:border-zinc-700 flex items-center justify-center gap-2">
                <svg class="w-4 h-4 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                </svg>
                Pending Verification
              </div>
            <% else %>
              <button
                phx-click="open_verification_modal"
                class="w-full md:w-40 px-6 py-2.5 bg-blue-600 text-white font-bold rounded-full text-sm hover:bg-blue-700 shadow-lg shadow-blue-600/30 hover:shadow-blue-600/50 transition-all flex items-center justify-center gap-2"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
                Get Verified
              </button>
            <% end %>
          <% end %>
          <.link
            navigate={~p"/users/#{@user.username}/creator-hub"}
            class="w-full md:w-40 px-6 py-2.5 bg-gray-900 text-white font-bold rounded-full text-sm text-center hover:bg-black transition-colors dark:bg-zinc-700 dark:hover:bg-zinc-600"
          >
            Creator Hub
          </.link>
        <% else %>
          <%= if @follow_state == "following" do %>
            <button
              phx-click="unfollow"
              class="w-full md:w-40 px-6 py-2.5 bg-white text-gray-700 font-bold rounded-full text-sm border-2 border-gray-200 hover:border-red-200 hover:bg-red-50 hover:text-red-600 transition-all shadow-sm dark:bg-zinc-800 dark:border-zinc-700 dark:text-white dark:hover:bg-red-900/30 dark:hover:text-red-400"
            >
              Following
            </button>
            <button
              phx-click="message_user"
              class="w-full md:w-40 px-6 py-2.5 bg-gray-100 text-gray-700 font-bold rounded-full text-sm hover:bg-gray-200 dark:bg-blue-900/20 dark:text-blue-200 dark:hover:bg-blue-900/40 transition-colors"
            >
              Message
            </button>
          <% else %>
            <button
              phx-click="follow"
              class="w-full md:w-40 px-6 py-2.5 bg-indigo-500 text-white font-bold rounded-full text-sm hover:bg-indigo-600 shadow-lg shadow-indigo-500/30 hover:shadow-indigo-500/50 transition-all transform hover:-translate-y-0.5"
            >
              <%= if @follow_state == "follow_back", do: "Follow Back", else: "Follow" %>
            </button>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <%!-- VERIFICATION MODAL --%>
  <%= if @show_verification_modal do %>
    <div class="fixed inset-0 z-50 overflow-y-auto" id="verification-modal">
      <div class="flex items-center justify-center min-h-screen px-4 py-10 text-center">
        <div class="fixed inset-0 bg-slate-950/70 backdrop-blur-sm" phx-click="close_verification_modal"></div>

        <div class="relative inline-block align-middle text-left w-full max-w-3xl">
          <div class="rounded-3xl border border-slate-800/60 bg-gradient-to-br from-slate-900 via-slate-900 to-slate-950 shadow-2xl shadow-blue-900/40 overflow-hidden">
            <div class="absolute inset-0 opacity-30 pointer-events-none">
              <div class="absolute -top-32 -left-32 h-72 w-72 rounded-full bg-blue-500/20 blur-3xl"></div>
              <div class="absolute -bottom-40 -right-32 h-80 w-80 rounded-full bg-indigo-500/20 blur-3xl"></div>
            </div>

            <div class="relative px-8 py-7">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <h3 class="text-sm tracking-[0.3em] text-slate-400 font-semibold">VERIFICATION REQUEST</h3>
                  <p class="mt-2 text-sm text-slate-400">
                    Link your social accounts and submit for verification.
                  </p>
                </div>
                <button
                  phx-click="close_verification_modal"
                  class="text-slate-500 hover:text-slate-300 transition-colors"
                >
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                  </svg>
                </button>
              </div>

              <div class="mt-7 grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <h4 class="text-xs font-semibold text-blue-300 tracking-wider uppercase">Add Social Account</h4>

                  <div class="mt-3 grid grid-cols-3 gap-3">
                    <%= for platform <- ["youtube", "instagram", "x", "twitch", "tiktok", "discord"] do %>
                      <% active = @social_form[:platform].value == platform %>
                      <button
                        type="button"
                        phx-click="validate_social"
                        phx-value-platform={platform}
                        phx-value-username={@social_form[:username].value || ""}
                        class={[
                          "h-16 rounded-xl border text-xs font-semibold uppercase tracking-wide transition-all",
                          active &&
                            "border-blue-500/80 bg-blue-500/10 text-blue-200 shadow-[0_0_18px_-6px_rgba(59,130,246,0.8)]" ||
                            "border-slate-800 bg-slate-900/60 text-slate-400 hover:text-slate-200 hover:border-slate-700"
                        ]}
                      >
                        <span class="flex flex-col items-center justify-center gap-1">
                          <span class={["w-5 h-5", active && "text-blue-300" || "text-slate-500"]}>
                            <%= case platform do %>
                              <% "youtube" -> %>
                                <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
                                  <path d="M23.5 6.2a3.1 3.1 0 0 0-2.2-2.2C19.3 3.5 12 3.5 12 3.5s-7.3 0-9.3.5A3.1 3.1 0 0 0 .5 6.2 32.7 32.7 0 0 0 0 12a32.7 32.7 0 0 0 .5 5.8 3.1 3.1 0 0 0 2.2 2.2c2 .5 9.3.5 9.3.5s7.3 0 9.3-.5a3.1 3.1 0 0 0 2.2-2.2A32.7 32.7 0 0 0 24 12a32.7 32.7 0 0 0-.5-5.8zM9.6 15.5V8.5l6.4 3.5-6.4 3.5z"/>
                                </svg>
                              <% "instagram" -> %>
                                <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
                                  <path d="M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4zm10 2H7a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2zm-5 3.5a3.5 3.5 0 1 1 0 7 3.5 3.5 0 0 1 0-7zm5.3-.8a1 1 0 1 1-2 0 1 1 0 0 1 2 0z"/>
                                </svg>
                              <% "x" -> %>
                                <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
                                  <path d="M18.9 2H22l-7.2 8.2L23 22h-6.6l-5.2-6.8L4.7 22H1.6l7.7-8.8L1 2h6.7l4.7 6.2L18.9 2zm-1.2 18h1.8L7.2 4H5.3l12.4 16z"/>
                                </svg>
                              <% "twitch" -> %>
                                <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
                                  <path d="M4 3h16v10l-4 4h-4l-2 2H8v-2H4V3zm2 2v10h4v2l2-2h4l2-2V5H6zm5 3h2v4h-2V8zm4 0h2v4h-2V8z"/>
                                </svg>
                              <% "tiktok" -> %>
                                <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
                                  <path d="M15 3c.5 2.1 2.1 3.7 4.2 4.1V10a7.1 7.1 0 0 1-4.2-1.5v7.1a5.6 5.6 0 1 1-5.6-5.6c.4 0 .8 0 1.1.1v2.9a2.6 2.6 0 1 0 2.5 2.6V3h2z"/>
                                </svg>
                              <% "discord" -> %>
                                <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
                                  <path d="M20 5.3A16 16 0 0 0 15.9 4l-.2.5a14 14 0 0 1 3.5 1.3 13 13 0 0 0-9.4 0A14 14 0 0 1 13.3 4l-.2-.5A16 16 0 0 0 4 5.3a16.9 16.9 0 0 0-2 11.3 16 16 0 0 0 4.9 2.5l1-1.6a10.6 10.6 0 0 1-2.2-1.1c.2.1.4.3.6.4a12.1 12.1 0 0 0 11.4 0l.6-.4c-.7.4-1.4.8-2.2 1.1l1 1.6a16 16 0 0 0 4.9-2.5A16.9 16.9 0 0 0 20 5.3zM9.4 14.3c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2zm5.2 0c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2z"/>
                                </svg>
                            <% end %>
                          </span>
                          <span class="block text-[10px]"><%= String.upcase(platform) %></span>
                        </span>
                      </button>
                    <% end %>
                  </div>

                  <div class="mt-5">
                    <label class="block text-xs font-semibold text-slate-400 tracking-wider uppercase mb-2">
                      Username
                    </label>
                    <form phx-change="validate_social">
                      <input type="hidden" name="platform" value={@social_form[:platform].value || "youtube"} />
                      <div class="flex items-center rounded-xl border border-slate-800 bg-slate-900/70 overflow-hidden">
                        <span class="px-3 py-2.5 text-xs text-slate-500 bg-slate-950/60 border-r border-slate-800">
                          <%= Vibeflow.Socials.get_social_prefix(@social_form[:platform].value || "youtube") %>
                        </span>
                        <input
                          type="text"
                          name="username"
                          value={@social_form[:username].value || ""}
                          placeholder="username"
                          class="w-full px-3 py-2.5 text-sm bg-transparent text-slate-200 placeholder-slate-600 focus:outline-none"
                        />
                      </div>
                    </form>
                  </div>

                  <div class="mt-5">
                    <button
                      type="button"
                      phx-click="add_social"
                      phx-value-platform={@social_form[:platform].value || "youtube"}
                      phx-value-username={@social_form[:username].value || ""}
                      class="w-full py-3 rounded-xl dark:bg-white bg-white text-slate-900 text-sm font-bold uppercase tracking-wide shadow-lg shadow-black/20 hover:brightness-110 transition"
                    >
                      + Add Link
                    </button>
                  </div>
                </div>

                <div>
                  <div class="flex items-center justify-between">
                    <h4 class="text-xs font-semibold text-blue-300 tracking-wider uppercase">Linked Accounts</h4>
                  </div>

                  <div class="mt-4 rounded-2xl border border-slate-800 bg-slate-900/60 p-4 min-h-[240px]">
                    <%= if Enum.empty?(@user.social_accounts) do %>
                      <div class="h-full flex flex-col items-center justify-center text-slate-600 text-sm">
                        <svg class="h-8 w-8 text-slate-700 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 13a5 5 0 007.07 0l2.12-2.12a5 5 0 10-7.07-7.07L10 6"></path>
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 11a5 5 0 00-7.07 0L4.81 13.12a5 5 0 107.07 7.07L14 18"></path>
                        </svg>
                        No accounts linked yet
                      </div>
                    <% else %>
                      <div class="space-y-3">
                        <%= for social <- @user.social_accounts do %>
                          <div class="flex items-center justify-between gap-3 rounded-xl border border-slate-800 bg-slate-950/60 px-3 py-2">
                            <div class="min-w-0">
                              <p class="text-xs font-semibold uppercase tracking-wide text-slate-300">
                                <%= social.platform %>
                              </p>
                              <p class="text-xs text-slate-500 truncate">
                                <%= social.url %>
                              </p>
                            </div>
                            <button
                              phx-click="remove_social"
                              phx-value-id={social.id}
                              class="text-xs text-red-400 hover:text-red-300 font-semibold"
                            >
                              Remove
                            </button>
                          </div>
                        <% end %>
                      </div>
                    <% end %>
                  </div>

                  <div class="mt-4">
                    <button
                      type="button"
                      phx-click="submit_verification"
                      class="w-full py-3 rounded-xl bg-slate-800 text-slate-400 text-sm font-bold uppercase tracking-wide border border-slate-700 hover:bg-slate-700 hover:text-slate-200 transition"
                    >
                      Submit Request
                    </button>
                  </div>
                </div>
              </div>

            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
  <%!-- POSTS SECTION --%>
  <div>
    <%!-- Tabs --%>
    <div class="flex justify-center gap-8 mb-8 border-b border-gray-200 dark:border-zinc-800">
      <div 
        phx-click="switch_tab" 
        phx-value-tab="posts"
        class={"flex items-center gap-2 px-6 py-3 font-medium text-sm tracking-wide cursor-pointer transition-colors " <>
          if @active_tab == "posts" do
            "border-b-2 border-gray-900 dark:border-white text-gray-900 dark:text-white font-bold"
          else
            "text-gray-400 hover:text-gray-600 dark:hover:text-gray-300"
          end
        }
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"
          />
        </svg>
        POSTS
      </div>
      <div 
        phx-click="switch_tab" 
        phx-value-tab="saved"
        class={"flex items-center gap-2 px-6 py-3 font-medium text-sm tracking-wide cursor-pointer transition-colors " <>
          if @active_tab == "saved" do
            "border-b-2 border-gray-900 dark:border-white text-gray-900 dark:text-white font-bold"
          else
            "text-gray-400 hover:text-gray-600 dark:hover:text-gray-300"
          end
        }
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"
          />
        </svg>
        SAVED
      </div>
    </div>

    <%= if @active_tab == "posts" do %>
      <%= if Enum.empty?(@posts) do %>
        <div class="bg-white dark:bg-zinc-900 rounded-2xl border-2 border-dashed border-gray-200 dark:border-zinc-700 py-24 flex flex-col items-center justify-center text-center">
          <div class="w-20 h-20 bg-gray-50 dark:bg-zinc-800 rounded-full flex items-center justify-center mb-4">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-10 w-10 text-gray-300"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
              />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-gray-900 dark:text-white">No Posts Yet</h3>
          <p class="text-gray-500 text-sm mt-1">When you post photos, they will appear here.</p>
        </div>
      <% else %>
        <%!-- GRID: Increased Gap & Rounded Items --%>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
          <%= for post <- @posts do %>
            <.link
              navigate={~p"/posts/#{post.uuid}"}
              class="relative group aspect-square bg-white dark:bg-zinc-800 cursor-pointer overflow-hidden rounded-2xl shadow-md hover:shadow-xl border border-gray-100 dark:border-zinc-700 transition-all duration-300 hover:-translate-y-1"
            >
              <%!-- Media Logic --%>
              <% media = (post.media_files || []) |> List.first()

              {url, is_video} =
                case media do
                  %{"url" => url, "type" => type} ->
                    {url, String.starts_with?(type || "", "video")}

                  %{"url" => url} ->
                    {url, String.ends_with?(String.downcase(url), [".mp4", ".mov"])}

                  url when is_binary(url) ->
                    {url, String.ends_with?(String.downcase(url), [".mp4", ".mov"])}

                  _ ->
                    {nil, false}
                end %>

              <%= if url do %>
                <%= if is_video do %>
                  <video
                    src={url}
                    class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500"
                    muted
                    playsinline
                  />
                  <div class="absolute top-2 right-2 bg-black/50 p-1.5 rounded-full backdrop-blur-sm">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-3 w-3 text-white"
                      fill="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path d="M10 16.5l6-4.5-6-4.5v9zM12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z" />
                    </svg>
                  </div>
                <% else %>
                  <img
                    src={url}
                    alt="Post"
                    loading="lazy"
                    class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500"
                  />
                <% end %>
              <% else %>
                <%!-- Text Fallback --%>
                <div class="w-full h-full flex items-center justify-center p-4 text-center bg-gradient-to-br from-gray-50 to-white dark:from-zinc-800 dark:to-zinc-900">
                  <p class="text-xs font-medium text-gray-500 dark:text-gray-400 line-clamp-4 italic">
                    "<%= post.content %>"
                  </p>
                </div>
              <% end %>

              <%!-- Hover Overlay: Likes & Comments --%>
              <div class="absolute inset-0 bg-black/40 backdrop-blur-[2px] flex items-center justify-center gap-8 text-white opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-4 group-hover:translate-y-0">
                <%!-- Likes Group --%>
                <div class="flex flex-col items-center gap-1">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-8 w-8 fill-white drop-shadow-md"
                    viewBox="0 0 24 24"
                  >
                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
                  </svg>
                  <span class="font-bold text-lg drop-shadow-sm"><%= post.likes_count || 0 %></span>
                </div>

                <%!-- Comments Group --%>
                <div class="flex flex-col items-center gap-1">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-8 w-8 fill-white drop-shadow-md"
                    viewBox="0 0 24 24"
                  >
                    <path d="M21.99 4c0-1.1-.89-2-1.99-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h14l4 4-.01-18z" />
                  </svg>
                  <span class="font-bold text-lg drop-shadow-sm">
                    <%= if Ecto.assoc_loaded?(post.comments), do: length(post.comments), else: 0 %>
                  </span>
                </div>
              </div>
            </.link>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <%!-- SAVED POSTS SECTION --%>
      <%= if @current_user && @current_user.id == @user.id do %>
        <%= if Enum.empty?(@saved_posts) do %>
          <div class="bg-white dark:bg-zinc-900 rounded-2xl border-2 border-dashed border-gray-200 dark:border-zinc-700 py-24 flex flex-col items-center justify-center text-center">
            <div class="w-20 h-20 bg-gray-50 dark:bg-zinc-800 rounded-full flex items-center justify-center mb-4">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-10 w-10 text-gray-300"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"
                />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 dark:text-white">No Saved Posts</h3>
            <p class="text-gray-500 text-sm mt-1">Posts you save will appear here.</p>
          </div>
        <% else %>
          <%!-- GRID: Saved Posts --%>
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
            <%= for post <- @saved_posts do %>
              <.link
                navigate={~p"/posts/#{post.uuid}"}
                class="relative group aspect-square bg-white dark:bg-zinc-800 cursor-pointer overflow-hidden rounded-2xl shadow-md hover:shadow-xl border border-gray-100 dark:border-zinc-700 transition-all duration-300 hover:-translate-y-1"
              >
                <%!-- Media Logic --%>
                <% media = (post.media_files || []) |> List.first()

                {url, is_video} =
                  case media do
                    %{"url" => url, "type" => type} ->
                      {url, String.starts_with?(type || "", "video")}

                    %{"url" => url} ->
                      {url, String.ends_with?(String.downcase(url), [".mp4", ".mov"])}

                    url when is_binary(url) ->
                      {url, String.ends_with?(String.downcase(url), [".mp4", ".mov"])}

                    _ ->
                      {nil, false}
                  end %>

                <%= if url do %>
                  <%= if is_video do %>
                    <video
                      src={url}
                      class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500"
                      muted
                      playsinline
                    />
                    <div class="absolute top-2 right-2 bg-black/50 p-1.5 rounded-full backdrop-blur-sm">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-3 w-3 text-white"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path d="M10 16.5l6-4.5-6-4.5v9zM12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z" />
                      </svg>
                    </div>
                  <% else %>
                    <img
                      src={url}
                      alt=""
                      loading="lazy"
                      class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500"
                    />
                  <% end %>
                <% else %>
                  <%!-- Text Fallback --%>
                  <div class="w-full h-full flex items-center justify-center p-4 text-center bg-gradient-to-br from-gray-50 to-white dark:from-zinc-800 dark:to-zinc-900">
                    <p class="text-sm text-gray-600 dark:text-gray-300 line-clamp-3" 
                       title={post.content}>
                      "<%= post.content %>"
                    </p>
                  </div>
                <% end %>

                <%!-- Hover Overlay: Likes & Comments --%>
                <div class="absolute inset-0 bg-black/40 backdrop-blur-[2px] flex items-center justify-center gap-8 text-white opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-4 group-hover:translate-y-0">
                  <div class="flex items-center gap-1.5">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                    </svg>
                    <span class="text-sm font-medium"><%= post.likes_count || 0 %></span>
                  </div>
                  <div class="flex items-center gap-1.5">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                    </svg>
                    <span class="text-sm font-medium"><%= post.comments_count || 0 %></span>
                  </div>
                </div>
                
                <%!-- Saved Badge --%>
                <div class="absolute top-2 left-2 bg-indigo-500 p-1.5 rounded-full backdrop-blur-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-white" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
                  </svg>
                </div>
              </.link>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <%!-- Other users can't see saved posts --%>
        <div class="bg-white dark:bg-zinc-900 rounded-2xl border-2 border-dashed border-gray-200 dark:border-zinc-700 py-24 flex flex-col items-center justify-center text-center">
          <div class="w-20 h-20 bg-gray-50 dark:bg-zinc-800 rounded-full flex items-center justify-center mb-4">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-10 w-10 text-gray-300"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
              />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-gray-900 dark:text-white">Private</h3>
          <p class="text-gray-500 text-sm mt-1">Only <%= @user.username %> can see their saved posts.</p>
        </div>
      <% end %>
    <% end %>
  </div>

  <%!-- FOLLOWERS/FOLLOWING MODAL --%>
  <%= if @show_followers_modal or @show_following_modal do %>
    <div class="fixed inset-0 z-50 overflow-y-auto" id="follows-modal">
      <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
        <%!-- Background overlay --%>
        <div class="fixed inset-0 transition-opacity" phx-click="close_modal">
          <div class="absolute inset-0 bg-gray-900 opacity-75"></div>
        </div>

        <%!-- Center modal --%>
        <span class="hidden sm:inline-block sm:align-middle sm:h-screen">&#8203;</span>
        <div class="inline-block align-bottom bg-white dark:bg-zinc-900 rounded-2xl text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
          <div class="bg-white dark:bg-zinc-900 px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
            <div class="sm:flex sm:items-start">
              <div class="w-full">
                <div class="flex items-center justify-between mb-4">
                  <h3 class="text-lg leading-6 font-medium text-gray-900 dark:text-white" id="modal-title">
                    <%= if @show_followers_modal do %>
                      Followers (<%= length(@followers) %>)
                    <% else %>
                      Following (<%= length(@following) %>)
                    <% end %>
                  </h3>
                  <button
                    phx-click="close_modal"
                    class="text-gray-400 hover:text-gray-500 dark:hover:text-gray-300 transition-colors"
                  >
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                  </button>
                </div>

                <%!-- Search Bar --%>
                <div class="mb-4">
                  <form phx-submit="search_follows" phx-change="search_follows">
                    <div class="relative">
                      <input
                        type="text"
                        name="search"
                        value={@search_query}
                        placeholder="Search users..."
                        class="w-full px-4 py-2 pl-10 border border-gray-300 dark:border-zinc-700 rounded-lg bg-white dark:bg-zinc-800 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                      />
                      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                      </div>
                    </div>
                  </form>
                </div>

                <%!-- Users List --%>
                <div class="max-h-96 overflow-y-auto">
                  <%= if @show_followers_modal do %>
                    <%= if Enum.empty?(@followers) do %>
                      <div class="text-center py-8 text-gray-500 dark:text-gray-400">
                        <svg class="mx-auto h-12 w-12 text-gray-300 dark:text-gray-600 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                        </svg>
                        <p>No followers found</p>
                      </div>
                    <% else %>
                      <%= for follower <- @followers do %>
                        <div class="flex items-center justify-between py-3 hover:bg-gray-50 dark:hover:bg-zinc-800 rounded-lg px-2 transition-colors">
                          <div class="flex items-center space-x-3">
                            <%= if follower.avatar_url do %>
                              <img src={follower.avatar_url} alt={follower.username} class="w-10 h-10 rounded-full object-cover" />
                            <% else %>
                              <div class="w-10 h-10 rounded-full bg-gradient-to-br from-indigo-100 to-indigo-200 text-indigo-600 dark:from-indigo-900 dark:to-zinc-800 dark:text-indigo-400 flex items-center justify-center font-bold text-sm">
                                <%= VibeflowWeb.CoreComponents.initials(follower) %>
                              </div>
                            <% end %>
                            <div>
                              <p class="text-sm font-medium text-gray-900 dark:text-white flex items-center gap-1">
                                <%= follower.username %>
                                <.verified_badge user={follower} class="h-5 w-5" />
                              </p>
                              <p class="text-xs text-gray-500 dark:text-gray-400"><%= follower.bio %></p>
                            </div>
                          </div>
                          <.link navigate={~p"/users/#{follower.username}"} class="text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300 text-sm font-medium">
                            View
                          </.link>
                        </div>
                      <% end %>
                    <% end %>
                  <% else %>
                    <%= if Enum.empty?(@following) do %>
                      <div class="text-center py-8 text-gray-500 dark:text-gray-400">
                        <svg class="mx-auto h-12 w-12 text-gray-300 dark:text-gray-600 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                        </svg>
                        <p>Not following anyone yet</p>
                      </div>
                    <% else %>
                      <%= for following_user <- @following do %>
                        <div class="flex items-center justify-between py-3 hover:bg-gray-50 dark:hover:bg-zinc-800 rounded-lg px-2 transition-colors">
                          <div class="flex items-center space-x-3">
                            <%= if following_user.avatar_url do %>
                              <img src={following_user.avatar_url} alt={following_user.username} class="w-10 h-10 rounded-full object-cover" />
                            <% else %>
                              <div class="w-10 h-10 rounded-full bg-gradient-to-br from-indigo-100 to-indigo-200 text-indigo-600 dark:from-indigo-900 dark:to-zinc-800 dark:text-indigo-400 flex items-center justify-center font-bold text-sm">
                                <%= VibeflowWeb.CoreComponents.initials(following_user) %>
                              </div>
                            <% end %>
                            <div>
                              <p class="text-sm font-medium text-gray-900 dark:text-white flex items-center gap-1">
                                <%= following_user.username %>
                                <.verified_badge user={following_user} class="h-5 w-5" />
                              </p>
                              <p class="text-xs text-gray-500 dark:text-gray-400"><%= following_user.bio %></p>
                            </div>
                          </div>
                          <.link navigate={~p"/users/#{following_user.username}"} class="text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300 text-sm font-medium">
                            View
                          </.link>
                        </div>
                      <% end %>
                    <% end %>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
