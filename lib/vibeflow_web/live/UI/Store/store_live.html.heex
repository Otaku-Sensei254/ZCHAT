<div class="max-w-4xl mx-auto p-6">
  <header class="flex justify-between items-center mb-10 bg-gradient-to-r from-blue-600 to-cyan-500 p-8 rounded-3xl text-white shadow-xl">
    <div>
      <h1 class="text-3xl font-bold italic tracking-tight">The Wave Store</h1>
      <p class="opacity-90">Exchange your energy for influence.</p>
    </div>
    <div class="text-right">
      <span class="block text-sm uppercase font-semibold opacity-75">Your Balance</span>
      <div class="flex items-center gap-2">
        <span class="text-4xl font-black"><%= @points_display %></span>
        <span class="text-2xl">🌊</span>
      </div>
      <p class="text-xs opacity-70 mt-1">
        Points track your likes, ripples, and post creations.
        <%= if @current_user do %>
          Keep creating to unlock more waves.
        <% else %>
          <span class="font-semibold">Log in</span> to start earning.
        <% end %>
      </p>
    </div>
  </header>

  <div class="space-y-12">
    
    <section>
      <div class="flex items-center gap-3 mb-6 border-b border-slate-200 pb-2">
        <h2 class="text-xl font-bold text-slate-800">Digital Flex</h2>
        <span class="px-2 py-0.5 bg-blue-100 text-blue-700 text-xs font-bold rounded-full uppercase">Status</span>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="group bg-white p-5 rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition-all">
          <div class="w-full h-32 bg-slate-50 rounded-xl mb-4 flex items-center justify-center border-2 border-dashed border-slate-200 group-hover:border-yellow-400 transition-colors">
             <div class="w-16 h-16 rounded-full border-4 border-yellow-400 bg-slate-200 shadow-[0_0_15px_rgba(250,204,21,0.5)]"></div>
          </div>
          <h3 class="font-bold text-slate-800">Golden Wave Border</h3>
          <p class="text-sm text-slate-500 mb-4">A shimmering gold frame for your profile picture.</p>
          <button class="w-full py-2 bg-slate-900 text-white rounded-lg font-semibold hover:bg-yellow-500 transition-colors">
            500 🌊
          </button>
        </div>

        <div class="group bg-white p-5 rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition-all">
          <div class="w-full h-32 bg-slate-50 rounded-xl mb-4 flex items-center justify-center italic font-black text-2xl text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-pink-500 to-red-500">
             VibeMaster
          </div>
          <h3 class="font-bold text-slate-800">Iridescent Name</h3>
          <p class="text-sm text-slate-500 mb-4">Your name glows in every comment section.</p>
          <button class="w-full py-2 bg-slate-900 text-white rounded-lg font-semibold hover:bg-purple-500 transition-colors">
            1,200 🌊
          </button>
        </div>
      </div>
    </section>

    <section>
      <div class="flex items-center gap-3 mb-6 border-b border-slate-200 pb-2">
        <h2 class="text-xl font-bold text-slate-800">Power-Ups</h2>
        <span class="px-2 py-0.5 bg-emerald-100 text-emerald-700 text-xs font-bold rounded-full uppercase">Utility</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="flex gap-4 bg-emerald-50 p-6 rounded-2xl border border-emerald-100">
          <div class="text-4xl">🚀</div>
          <div>
            <h3 class="font-bold text-emerald-900">Tidal Wave (Boost)</h3>
            <p class="text-sm text-emerald-700 mb-3">Instantly seed your post to 20 additional active users.</p>
            <button class="px-6 py-2 bg-emerald-600 text-white rounded-lg font-bold hover:bg-emerald-700">
              150 🌊
            </button>
          </div>
        </div>

        <div class="flex gap-4 bg-blue-50 p-6 rounded-2xl border border-blue-100">
          <div class="text-4xl">🍾</div>
          <div>
            <h3 class="font-bold text-blue-900">Message in a Bottle</h3>
            <p class="text-sm text-blue-700 mb-3">Send a random positive vibe to an anonymous user.</p>
            <button class="px-6 py-2 bg-blue-600 text-white rounded-lg font-bold hover:bg-blue-700">
              50 🌊
            </button>
          </div>
        </div>
      </div>
    </section>

  </div>
</div>
