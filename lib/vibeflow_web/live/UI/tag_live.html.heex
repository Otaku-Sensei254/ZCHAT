<div class="min-h-screen bg-gray-50 dark:bg-zinc-900">
  <div class="max-w-2xl mx-auto px-4 py-6">
    <!-- Header -->
    <div class="mb-6">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 bg-indigo-100 dark:bg-indigo-900 rounded-full flex items-center justify-center">
            <svg
              class="w-6 h-6 text-indigo-600 dark:text-indigo-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"
              >
              </path>
            </svg>
          </div>
          <div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">
              ##{@tag}
            </h1>
            <p class="text-sm text-gray-500 dark:text-gray-400">
              Explore posts tagged with
              <span class="font-medium text-indigo-600 dark:text-indigo-400">#@{@tag}</span>
            </p>
          </div>
        </div>

        <%= if @similar_tags != [] do %>
          <button
            phx-click="toggle_similar"
            class="px-4 py-2 bg-white dark:bg-zinc-800 border border-gray-200 dark:border-zinc-700 rounded-lg text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-zinc-700 transition-colors"
          >
            <svg
              class="w-4 h-4 inline-block mr-2"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h16M4 18h16"
              >
              </path>
            </svg>
            {if @show_similar_first, do: "Show Exact Matches", else: "Include Similar Tags"}
          </button>
        <% end %>
      </div>
      
<!-- Similar Tags -->
      <%= if @similar_tags != [] and @show_similar_first do %>
        <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg p-4">
          <div class="flex items-center gap-2 mb-2">
            <svg
              class="w-5 h-5 text-blue-600 dark:text-blue-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 10V3L4 14h7v7l9-11h-7z"
              >
              </path>
            </svg>
            <h3 class="text-sm font-semibold text-blue-900 dark:text-blue-100">Similar Tags</h3>
          </div>
          <div class="flex flex-wrap gap-2">
            <%= for similar_tag <- @similar_tags do %>
              <.link
                navigate={~p"/tags/#{similar_tag}"}
                class="inline-flex items-center px-3 py-1 bg-blue-100 dark:bg-blue-800 text-blue-800 dark:text-blue-200 text-sm rounded-full hover:bg-blue-200 dark:hover:bg-blue-700 transition-colors"
              >
                ##{similar_tag}
              </.link>
            <% end %>
          </div>
          <p class="text-xs text-blue-700 dark:text-blue-300 mt-2">
            Also showing posts from similar tags to help you discover related content
          </p>
        </div>
      <% end %>
    </div>
    
<!-- Posts Stream -->
    <div id="posts" phx-update="stream" class="space-y-4">
      <%= for {id, post} <- @streams.posts do %>
        <.live_component
          module={VibeflowWeb.UI.PostComponent}
          id={id}
          post={post}
          current_user={@current_user}
          like_count={post.likes_count}
          repost_count={0}
        />
      <% end %>
    </div>
    
<!-- Empty State -->
    <%= if map_size(@streams.posts) == 0 do %>
      <div class="text-center py-12">
        <div class="w-16 h-16 bg-gray-100 dark:bg-zinc-800 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg
            class="w-8 h-8 text-gray-400 dark:text-gray-500"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"
            >
            </path>
          </svg>
        </div>
        <h3 class="text-lg font-medium text-gray-900 dark:text-gray-100 mb-2">
          No posts found
        </h3>
        <p class="text-gray-500 dark:text-gray-400 mb-4">
          No posts have been tagged with ##{@tag} yet.
        </p>
        <.link
          navigate={~p"/"}
          class="inline-flex items-center px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors"
        >
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10 19l-7-7m0 0l7-7m-7 7h18"
            >
            </path>
          </svg>
          Back to Feed
        </.link>
      </div>
    <% end %>
    
<!-- Load More -->
    <%= if @has_more and map_size(@streams.posts) > 0 do %>
      <div class="text-center mt-8">
        <button
          phx-click="load_more"
          phx-disable-with="Loading..."
          class="inline-flex items-center px-6 py-3 bg-white dark:bg-zinc-800 border border-gray-200 dark:border-zinc-700 rounded-lg text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-zinc-700 transition-colors"
        >
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 9l-7 7-7-7"
            >
            </path>
          </svg>
          Load More Posts
        </button>
      </div>
    <% end %>
  </div>
</div>
