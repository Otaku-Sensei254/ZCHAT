<div class="relative">
  <button
    phx-click={JS.toggle(to: "#notif-dropdown-#{@id}")}
    phx-click-away={JS.hide(to: "#notif-dropdown-#{@id}")}
    class="relative p-2 text-gray-600 dark:text-gray-300 hover:text-indigo-500 dark:hover:text-indigo-400 transition-colors rounded-full hover:bg-gray-100 dark:hover:bg-zinc-700"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
    </svg>
    
    <%= if @unread_count > 0 do %>
      <span class="absolute top-0 right-0 flex h-4 w-4 items-center justify-center rounded-full bg-red-500 text-[10px] font-bold text-white ring-2 ring-white dark:ring-zinc-800 animate-pulse">
        <%= if @unread_count > 9, do: "9+", else: @unread_count %>
      </span>
    <% end %>
  </button>

  <div 
    id={"notif-dropdown-#{@id}"} 
    class="hidden fixed left-4 right-4 top-[4.5rem] md:absolute md:left-auto md:top-auto md:right-0 md:mt-2 w-auto md:w-80 bg-white dark:bg-zinc-800 rounded-xl shadow-xl border border-gray-100 dark:border-zinc-700 z-[60] overflow-hidden transition-colors duration-200"
  >
    <div class="px-4 py-3 border-b border-gray-100 dark:border-zinc-700 bg-gray-50 dark:bg-zinc-800 flex justify-between items-center">
      <h3 class="text-sm font-bold text-gray-800 dark:text-gray-200">Notifications</h3>
      <div class="flex gap-2">
        <%= if @unread_count > 0 do %>
          <button 
            phx-click="mark_all_read" 
            phx-target={@myself} 
            class="text-xs text-blue-600 dark:text-blue-400 hover:underline font-medium"
          >
            Mark all read
          </button>
        <% end %>
        <%= if length(@notifications) > 0 do %>
          <button 
            phx-click="clear_notifications" 
            phx-target={@myself} 
            class="text-xs text-red-600 dark:text-red-400 hover:underline font-medium"
            onclick="return confirm('Are you sure you want to clear all notifications?')"
          >
            Clear all
          </button>
        <% end %>
      </div>
    </div>

    <div class="max-h-[400px] overflow-y-auto dark:bg-zinc-800">
      <%= if Enum.empty?(@notifications) do %>
        <div class="p-8 text-center text-zinc-400 dark:text-zinc-500 text-sm">No notifications yet.</div>
      <% else %>
        <%= for notif <- @notifications do %>
          <div class={"p-4 border-b border-zinc-50 dark:border-zinc-700 hover:bg-zinc-50 dark:hover:bg-zinc-700/50 transition-colors flex gap-3 #{if is_nil(notif.read_at), do: "bg-blue-50/30 dark:bg-blue-900/20"}"}>
            <.link navigate={~p"/users/#{notif.actor.username}"} class="shrink-0">
              <%= if notif.actor.avatar_url do %>
                <img src={notif.actor.avatar_url} class={"w-10 h-10 rounded-full object-cover " <> VibeflowWeb.CoreComponents.avatar_frame_class(notif.actor)} />
              <% else %>
                <div class={"w-10 h-10 rounded-full bg-zinc-200 dark:bg-zinc-600 flex items-center justify-center font-bold text-zinc-500 dark:text-zinc-300 text-xs " <> VibeflowWeb.CoreComponents.avatar_frame_class(notif.actor)}>
                  <%= String.first(notif.actor.username) %>
                </div>
              <% end %>
            </.link>

            <div class="flex-1 min-w-0">
              <p class="text-sm text-gray-800 dark:text-gray-200 leading-snug">
                <span class={"font-bold " <> VibeflowWeb.CoreComponents.username_glow_class(notif.actor)}><%= notif.actor.username %></span> 
                <span class="text-gray-600 dark:text-gray-400"><%= format_text(notif) %></span>
              </p>
              <p class="text-xs text-gray-400 dark:text-gray-500 mt-1">
                <%= Timex.from_now(notif.inserted_at) %>
              </p>
            </div>

            <%= if follow_back?(notif, @current_user) do %>
              <button
                phx-click="follow_back"
                phx-value-user-id={notif.actor_id}
                phx-target={@myself}
                class="self-center flex-shrink-0 px-3 py-1.5 text-xs font-semibold rounded-full bg-indigo-500 text-white hover:bg-indigo-600 transition-colors"
              >
                Follow Back
              </button>
            <% end %>

            <.link 
              navigate={notification_link(notif, @current_user)}
              phx-click="mark_as_read"
              phx-value-id={notif.id}
              phx-target={@myself}
              class="self-center flex-shrink-0 p-2 text-blue-600 dark:text-blue-400 hover:bg-blue-50 dark:hover:bg-zinc-700 rounded-full transition-colors"
              title="View"
            >
              <%= if is_nil(notif.read_at) do %>
                <div class="w-2.5 h-2.5 bg-blue-600 dark:bg-blue-400 rounded-full"></div>
              <% else %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-300 dark:text-gray-600" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                </svg>
              <% end %>
            </.link>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
