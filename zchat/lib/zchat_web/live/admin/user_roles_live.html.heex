<div class="container mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold mb-6">Edit Roles for {@user.username}</h1>

  <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6 mb-6">
    <div class="space-y-4">
      <%= for role <- @roles do %>
        <div class="flex items-center">
          <input
            type="checkbox"
            id={"role_#{role.name}"}
            checked={Enum.any?(@user.roles, &(&1.id == role.id))}
            phx-click="toggle_role"
            phx-value-role={role.name}
            class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded"
          />
          <label
            for={"role_#{role.name}"}
            class="ml-3 block text-sm font-medium text-gray-700 dark:text-gray-300"
          >
            {role.name} - <span class="text-gray-500">{role.description}</span>
          </label>
        </div>
      <% end %>
    </div>

    <div class="mt-6">
      <.link
        navigate={~p"/admin/dashboard"}
        class="px-4 py-2 bg-gray-200 dark:bg-gray-700 text-gray-800 dark:text-gray-200 rounded hover:bg-gray-300 dark:hover:bg-gray-600"
      >
        Back to Users
      </.link>
    </div>
  </div>
</div>
