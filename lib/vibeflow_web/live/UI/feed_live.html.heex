<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
  <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
    
    <div class="hidden lg:block lg:col-span-1">
      <div class="sticky top-24">
        <div class="bg-white dark:bg-zinc-900 rounded-lg shadow p-4 mb-6 border border-gray-100 dark:border-zinc-800">
          <h3 class="text-lg font-medium text-gray-900 dark:text-gray-100 mb-4">Categories</h3>
          <ul class="space-y-2 max-h-[calc(100vh-200px)] overflow-y-auto custom-scrollbar pr-2">
            <li>
              <.link patch={~p"/feed"} class={[
                "block px-3 py-2 rounded transition-colors",
                is_nil(@category) && "bg-blue-50 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300 font-medium",
                !is_nil(@category) && "text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-zinc-800"
              ]}>
                All Categories
              </.link>
            </li>
            <%= for category <-["Tech", "Drama", "Action", "Fiction","Music", "Fitness", "Sports", "Thrills", "Science", "Fashion", "Beauty","Gossip","Food", "Politics", "Business", "Comedy", "Nature", "Couples", "Kids"]do %>
              <li>
                <.link patch={~p"/feed?category=#{category}"} class={[
                  "block px-3 py-2 rounded transition-colors",
                  @category == category && "bg-blue-50 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300 font-medium",
                  @category != category && "text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-zinc-800"
                ]}>
                  <%= category %>
                </.link>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>

    <div class="lg:col-span-2 relative">
      
    <div class="bg-white dark:bg-zinc-900 rounded-lg shadow border border-gray-100 dark:border-zinc-800 p-3 mb-4">
  <div class="flex gap-3 overflow-x-auto scrollbar-hide">
    
    <%= if @current_user do %>
      <.link navigate={~p"/waves"} class="flex flex-col items-center gap-1 cursor-pointer shrink-0">
        <div class="relative w-14 h-14 rounded-full border-2 border-dashed border-blue-400 p-0.5 flex items-center justify-center hover:bg-gray-50 dark:hover:bg-zinc-800 transition group">
          <%= if @current_user.avatar_url do %>
            <img src={@current_user.avatar_url} class="w-full h-full rounded-full object-cover opacity-60 group-hover:opacity-100 transition" />
          <% else %>
            <div class="w-full h-full rounded-full bg-blue-100 text-blue-600 dark:bg-blue-900 dark:text-blue-400 flex items-center justify-center font-bold text-sm opacity-60 group-hover:opacity-100 transition">
              <%= VibeflowWeb.CoreComponents.initials(@current_user) %>
            </div>
          <% end %>
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="bg-blue-500 text-white rounded-full p-0.5 shadow-sm">
              <.icon name="hero-plus" class="w-4 h-4" />
            </div>
          </div>
        </div>
        <span class="text-[10px] font-medium text-gray-600 dark:text-gray-400 truncate w-14 text-center">You</span>
      </.link>

      <div class="w-px bg-gray-200 dark:bg-zinc-700 mx-1 h-14"></div>
    <% else %>
      <.link navigate={~p"/users/log_in"} class="flex flex-col items-center gap-1 cursor-pointer shrink-0">
         <div class="w-14 h-14 rounded-full border-2 border-dashed border-gray-400 flex items-center justify-center bg-gray-100 dark:bg-zinc-800">
             <.icon name="hero-arrow-right-end-on-rectangle" class="w-6 h-6 text-gray-500" />
         </div>
         <span class="text-[10px] font-medium text-gray-600 dark:text-gray-400">Log In</span>
      </.link>
      <div class="w-px bg-gray-200 dark:bg-zinc-700 mx-1 h-14"></div>
    <% end %>

    <%= for wave_group <- @waves do %>
      <.link navigate={~p"/waves/view/#{wave_group.user.id}"} class="flex flex-col items-center gap-1 cursor-pointer shrink-0">
        <div class={[
          "relative w-14 h-14 rounded-full p-0.5 flex items-center justify-center transition group",
          wave_group.has_unseen && "bg-gradient-to-tr from-yellow-400 to-pink-600",
          !wave_group.has_unseen && "border-2 border-gray-200 dark:border-zinc-700"
        ]}>
          <div class="bg-white dark:bg-zinc-900 rounded-full p-0.5">
            <img src={wave_group.user.avatar_url} class="w-full h-full rounded-full object-cover" />
          </div>
        </div>
        <span class="text-[10px] font-medium text-gray-600 dark:text-gray-400 truncate w-14 text-center"><%= wave_group.user.username %></span>
      </.link>
    <% end %>
    </div>
</div>

      <div class="sticky top-[62px] z-30 pb-2 -mx-4 px-4 sm:mx-0 sm:px-0 bg-gray-50/95 dark:bg-[rgb(9,9,11)] backdrop-blur-sm transition-colors">
        
        <div class="bg-white dark:bg-zinc-900 rounded-lg shadow mb-2 p-2 relative z-20 border border-gray-100 dark:border-zinc-800">
          <div class="relative" phx-click-away="close_search">
            <form phx-submit="search" onsubmit="return false;">
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                  <svg class="h-5 w-5 text-gray-400 dark:text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                  </svg>
                </div>
                <input
                  type="text"
                  name="search"
                  value={@search_term || ""}
                  placeholder="Search..."
                  phx-debounce="300"
                  phx-change="live_search"
                  autocomplete="off"
                  class="w-full pl-10 pr-3 py-1.5 text-sm border border-gray-200 dark:border-zinc-700 rounded-md bg-gray-50 dark:bg-zinc-800/50 text-gray-900 dark:text-gray-100 placeholder-gray-500 focus:ring-1 focus:ring-blue-500 focus:border-blue-500 dark:focus:ring-blue-400 transition-colors"
                />
                
                <%= if @show_search and @search_results != [] do %>
                  <div class="absolute top-full left-0 right-0 mt-2 bg-white dark:bg-zinc-800 border border-gray-200 dark:border-zinc-700 rounded-lg shadow-xl overflow-hidden z-50">
                    <%= for result <- @search_results do %>
                      <.link 
                        navigate={if result.type == :user, do: ~p"/users/#{result.title}", else: ~p"/posts/#{result.id}"}
                        class="flex items-center gap-3 p-3 hover:bg-gray-50 dark:hover:bg-zinc-700 transition-colors border-b border-gray-100 dark:border-zinc-700 last:border-0"
                        phx-click="close_search" 
                      >
                        <div class="shrink-0">
                          <%= if result.image do %>
                            <img src={result.image} class="w-8 h-8 rounded-full object-cover" />
                          <% else %>
                            <div class="w-8 h-8 rounded-full bg-gray-100 dark:bg-zinc-700 flex items-center justify-center">
                              <.icon name="hero-user" class="w-4 h-4 text-gray-500" />
                            </div>
                          <% end %>
                        </div>
                        <div class="flex flex-col">
                          <span class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= result.title %></span>
                        </div>
                      </.link>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </form>
          </div>
        </div>

        <div class="lg:hidden mb-2">
          <div class="flex overflow-x-auto gap-2 no-scrollbar pb-1">
             <.link patch={~p"/feed"} class={[
              "shrink-0 px-3 py-1 rounded-full text-xs font-medium border transition-colors",
              is_nil(@category) && "bg-blue-600 text-white border-blue-600 dark:bg-blue-500 dark:border-blue-500",
              !is_nil(@category) && "bg-white text-gray-700 border-gray-300 hover:bg-gray-50 dark:bg-zinc-800 dark:text-gray-300 dark:border-zinc-700 dark:hover:bg-zinc-700"
            ]}>All</.link>
            
            <%= for category <- ["Tech", "Drama", "Action", "Fiction", "Music", "Fitness", "Sports", "Thrills", "Science", "Fashion", "Beauty", "Gossip", "Food", "Politics", "Business", "Comedy", "Nature", "Couples", "Kids"] do %>
              <.link patch={~p"/feed?category=#{category}"} class={[
                "shrink-0 px-3 py-1 rounded-full text-xs font-medium border transition-colors",
                @category == category && "bg-blue-600 text-white border-blue-600 dark:bg-blue-500 dark:border-blue-500",
                @category != category && "bg-white text-gray-700 border-gray-300 hover:bg-gray-50 dark:bg-zinc-800 dark:text-gray-300 dark:border-zinc-700 dark:hover:bg-zinc-700"
              ]}><%= category %></.link>
            <% end %>
          </div>
        </div>

        <%= if assigns[:pending_posts] && length(@pending_posts) > 0 do %>
          <div class="flex justify-center mt-2 animate-bounce">
            <button phx-click="load_new_posts" class="flex items-center gap-1 bg-blue-500 hover:bg-blue-600 text-white text-xs font-bold py-1.5 px-4 rounded-full shadow">
              <span>Show New Posts</span>
            </button>
          </div>
        <% end %>
        
        <div class="absolute bottom-0 left-0 right-0 h-4 bg-gradient-to-b from-transparent to-gray-50/10 dark:to-zinc-950/10 pointer-events-none"></div>
      </div>

      <div id="posts" phx-update="stream" class="space-y-4 pt-2">
        <%= for {id, post} <- @streams.posts do %>
          <.live_component module={VibeflowWeb.UI.PostComponent} id={id} post={post} current_user={@current_user} />
        <% end %>
      </div>

      <div id="infinite-scroll-trigger" phx-hook="InfiniteScroll" class="h-20 w-full flex justify-center items-center mt-4">
        <%= if @loading do %>
          <div class="animate-spin rounded-full h-6 w-6 border-b-2 border-blue-500"></div>
        <% end %>
      </div>

    </div>

    <div class="hidden lg:block lg:col-span-1">
      <div class="sticky top-24">
        <div class="bg-white dark:bg-zinc-900 rounded-lg shadow p-4 border border-gray-100 dark:border-zinc-800">
          <h3 class="text-lg font-medium text-gray-900 dark:text-gray-100 mb-4">Trending</h3>
          <div class="space-y-4">
            <%= for {_id, post} <- @streams.trending do %>
              <div class="text-sm">
                <.link navigate={~p"/posts/#{post.id}"} class="block hover:bg-gray-50 dark:hover:bg-zinc-800 p-2 rounded transition-colors">
                  <p class="font-medium text-gray-900 dark:text-gray-200 line-clamp-2"><%= post.title || "Untitled" %></p>
                  <p class="text-gray-500 dark:text-gray-400 text-xs mt-1">
                    <%= length(post.likes) %> likes • <%= Timex.from_now(post.inserted_at) %>
                  </p>
                </.link>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

  </div>

  <%= if @show_share_modal do %>
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
      <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" phx-click="close_share_modal"></div>

      <div class="relative bg-white dark:bg-zinc-900 w-full max-w-lg rounded-2xl shadow-2xl border border-gray-100 dark:border-zinc-800 overflow-hidden">
        <!-- Header -->
        <div class="flex items-center justify-between p-6 border-b border-gray-100 dark:border-zinc-800">
          <h3 class="text-xl font-semibold text-gray-900 dark:text-gray-100">Share post</h3>
          <button phx-click="close_share_modal" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <!-- Search Bar -->
        <div class="p-6 pb-4">
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
              <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </div>
            <form phx-change="filter_friends" onsubmit="return false;">
              <input 
                type="text" 
                name="friend_search" 
                value={@friends_filter || ""} 
                placeholder="Search" 
                class="w-full pl-10 pr-4 py-3 bg-gray-50 dark:bg-zinc-800 border border-gray-200 dark:border-zinc-700 rounded-xl text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
              />
            </form>
          </div>
        </div>

        <!-- Friends Selection -->
        <div class="px-6 pb-4">
          <div class="flex items-center justify-between mb-4">
            <span class="text-sm text-gray-600 dark:text-gray-400">Suggested friends</span>
            <button phx-click="select_all_friends" class="text-sm text-indigo-600 dark:text-indigo-400 hover:underline font-medium">
              Select all
            </button>
          </div>

          <form phx-change="update_selected_friends" phx-submit="confirm_share">
            <div class="grid grid-cols-4 gap-4 max-h-48 overflow-y-auto pr-2">
              <%= for friend <- (@friends_list_filtered || @friends_list || []) do %>
                <label class="flex flex-col items-center gap-2 cursor-pointer group">
                  <input 
                    type="checkbox" 
                    name="recipient_ids[]" 
                    value={to_string(friend.id)} 
                    class="hidden peer" 
                    checked={Enum.member?(@selected_friends || [], friend.id)} 
                  />
                  <div class="relative">
                    <div class="w-14 h-14 rounded-full overflow-hidden bg-gray-100 dark:bg-zinc-800 flex items-center justify-center text-lg font-semibold text-gray-600 dark:text-gray-400 peer-checked:ring-2 peer-checked:ring-indigo-500 peer-checked:ring-offset-2 transition-all">
                      <%= if friend.avatar_url && friend.avatar_url != "" do %>
                        <img src={friend.avatar_url} class="w-full h-full object-cover" />
                      <% else %>
                        <%= VibeflowWeb.CoreComponents.initials(friend) %>
                      <% end %>
                    </div>
                    <div class="absolute bottom-0 right-0 w-5 h-5 bg-indigo-500 rounded-full border-2 border-white dark:border-zinc-900 opacity-0 peer-checked:opacity-100 transition-opacity flex items-center justify-center">
                      <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                      </svg>
                    </div>
                  </div>
                  <span class="text-xs text-gray-700 dark:text-gray-300 text-center truncate w-full">
                    <%= friend.username || friend.name || friend.email %>
                  </span>
                </label>
              <% end %>
            </div>

            <!-- Message Input -->
            <div class="mt-6 pt-4 border-t border-gray-100 dark:border-zinc-800">
              <div class="mb-3">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Add a message (optional)
                </label>
                <textarea 
                  name="share_message"
                  placeholder="Type a message..."
                  rows="3"
                  class="w-full px-4 py-3 bg-gray-50 dark:bg-zinc-800 border border-gray-200 dark:border-zinc-700 rounded-xl text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent resize-none"
                ></textarea>
              </div>

              <!-- Action Buttons -->
              <div class="flex justify-end gap-3">
                <button 
                  type="button" 
                  phx-click="close_share_modal" 
                  class="px-6 py-2.5 text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-zinc-800 hover:bg-gray-200 dark:hover:bg-zinc-700 rounded-xl font-medium transition-colors"
                >
                  Cancel
                </button>
                <button 
                  type="submit" 
                  class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-medium transition-colors flex items-center gap-2"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                  </svg>
                  Send
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  <% end %>

  </div>