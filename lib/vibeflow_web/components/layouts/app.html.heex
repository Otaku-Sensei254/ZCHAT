<div id="notifications-hook" phx-hook="NotificationsHook" class="hidden"></div>

<%= unless assigns[:hide_header] do %>
  <header class="fixed top-0 left-0 right-0 z-50 bg-white dark:bg-zinc-900 shadow-sm border-b border-gray-100 dark:border-zinc-800">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 ">
      <nav class="flex items-center justify-between h-16">
        <div class="flex-shrink-0">
          <.link navigate={~p"/"} class="flex items-center gap-2 group">
            <span class="text-indigo-500 text-2xl font-bold tracking-tighter group-hover:text-indigo-600 transition-colors dark:text-indigo-400 dark:group-hover:text-indigo-300">
              VF
            </span>
          </.link>
        </div>

        <div class="hidden md:flex items-center space-x-6">
          <%= if @current_user do %>
            <.link
              navigate={~p"/feed"}
              class="text-gray-600 dark:text-gray-300 hover:text-indigo-600 dark:hover:text-indigo-400 text-sm font-medium transition-colors hover:bg-gray-50 dark:hover:bg-zinc-800 px-3 py-2 rounded-lg"
            >
              Feed
            </.link>

            <button
              class="text-gray-600 dark:text-gray-300 hover:text-indigo-600 dark:hover:text-indigo-400 text-sm font-medium transition-colors hover:bg-gray-50 dark:hover:bg-zinc-800 px-3 py-2 rounded-lg flex items-center gap-1"
              title="Coming Soon"
            >
              <span>
                <.link
                  navigate={~p"/chat"}
                  class="text-gray-600 dark:text-gray-300 hover:text-indigo-600 dark:hover:text-indigo-400 text-sm font-medium transition-colors hover:bg-gray-50 dark:hover:bg-zinc-800 px-3 py-2 rounded-lg flex items-center gap-1"
                >
                  Chats
                  <%= if assigns[:unread_chats_count] && @unread_chats_count > 0 do %>
                    <span class="bg-blue-100 text-blue-700 dark:bg-blue-900 dark:text-blue-300 text-[10px] px-1.5 py-0.5 rounded-full font-bold">
                      {@unread_chats_count}
                    </span>
                  <% end %>
                </.link>
              </span>
            </button>

            <.link
              navigate={~p"/users/settings"}
              class="text-gray-600 dark:text-gray-300 hover:text-indigo-600 dark:hover:text-indigo-400 text-sm font-medium transition-colors hover:bg-gray-50 dark:hover:bg-zinc-800 px-3 py-2 rounded-lg"
            >
              Settings
            </.link>

            <div class="relative">
              <.live_component
                module={VibeflowWeb.Components.NotificationsModal}
                id="notifications-modal-desktop"
                current_user={@current_user}
              />
            </div>

            <.link
              navigate={~p"/posts/new"}
              class="bg-indigo-500 text-white border border-indigo-600 hover:bg-indigo-600 px-4 py-2 rounded-full text-sm font-bold transition-all shadow-sm hover:shadow-md flex items-center gap-2 dark:bg-indigo-600 dark:hover:bg-indigo-700 dark:border-indigo-700"
            >
              <span>Create</span>
              <span>📝</span>
            </.link>
            
<!-- Theme Toggle Button -->
            <button
              type="button"
              class="p-2 text-gray-600 hover:text-indigo-600 dark:text-gray-300 dark:hover:text-indigo-400 transition-colors rounded-full hover:bg-gray-100 dark:hover:bg-zinc-800"
              aria-label="Toggle dark mode"
              id="theme-toggle"
              phx-hook="ThemeToggle"
            >
              <!-- Sun icon (shown in dark mode) -->
              <svg
                class="w-5 h-5 dark:block hidden"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
                >
                </path>
              </svg>
              <!-- Moon icon (shown in light mode) -->
              <svg
                class="w-5 h-5 dark:hidden"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
                >
                </path>
              </svg>
            </button>
            
<!-- Theme Toggle Script -->

            <.link
              navigate={~p"/users/#{@current_user.username}"}
              class="flex items-center gap-2 pl-2 pr-3 py-1 rounded-full hover:bg-gray-100 dark:hover:bg-zinc-800 transition-colors border border-transparent hover:border-gray-200 dark:hover:border-zinc-700"
            >
              <%= if @current_user.avatar_url do %>
                <img
                  src={@current_user.avatar_url}
                  alt="Avatar"
                  class={"h-8 w-8 rounded-full object-cover border border-gray-200 dark:border-zinc-700 " <> VibeflowWeb.CoreComponents.avatar_frame_class(@current_user)}
                  referrerpolicy="no-referrer"
                />
              <% else %>
                <div class={"h-8 w-8 rounded-full bg-indigo-100 text-indigo-600 dark:bg-indigo-900 dark:text-indigo-400 flex items-center justify-center font-bold text-xs border border-indigo-200 dark:border-indigo-800 " <> VibeflowWeb.CoreComponents.avatar_frame_class(@current_user)}>
                  {String.first(@current_user.username || "?") |> String.upcase()}
                </div>
              <% end %>
            </.link>

            <.form for={%{}} action={~p"/users/log_out"} method="post" class="inline" as={:user}>
              <input type="hidden" name="_method" value="delete" />
              <button
                type="submit"
                class="text-gray-400 dark:text-gray-500 hover:text-red-600 dark:hover:text-red-500 p-2 rounded-full hover:bg-red-50 dark:hover:bg-red-900/50 transition-colors"
                title="Log out"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
                  />
                </svg>
              </button>
            </.form>
          <% else %>
            <.link
              navigate={~p"/users/log_in"}
              class="text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white font-medium text-sm px-4 py-2"
            >
              Log in
            </.link>
            <.link
              navigate={~p"/users/register"}
              class="bg-indigo-500 hover:bg-indigo-600 text-white px-5 py-2 rounded-full text-sm font-medium transition-all shadow-sm hover:shadow-md"
            >
              Sign up
            </.link>
          <% end %>
        </div>

        <div class="md:hidden flex items-center gap-1.5">
          <%= if @current_user do %>
            <.live_component
              module={VibeflowWeb.Components.NotificationsModal}
              id="notifications-modal-mobile"
              current_user={@current_user}
            />
            
<!-- Mobile theme toggle placed next to notifications for quick access -->
            <button
              type="button"
              id="mobile-theme-toggle"
              phx-hook="ThemeToggle"
              aria-label="Toggle dark mode"
              class="p-2 text-gray-500 hover:text-indigo-500 dark:text-gray-300 dark:hover:text-indigo-400 rounded-full hover:bg-gray-50 dark:hover:bg-zinc-800 transition-colors"
            >
              <!-- Sun icon (shown in dark mode) -->
              <svg
                class="w-5 h-5 dark:block hidden"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
                >
                </path>
              </svg>
              <!-- Moon icon (shown in light mode) -->
              <svg
                class="w-5 h-5 dark:hidden"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
                >
                </path>
              </svg>
            </button>
            <.form for={%{}} action={~p"/users/log_out"} method="post" class="inline" as={:user}>
              <input type="hidden" name="_method" value="delete" />
              <button
                type="submit"
                class="text-gray-400 dark:text-gray-500 hover:text-red-600 dark:hover:text-red-500 p-2 rounded-full hover:bg-red-50 dark:hover:bg-red-900/50 transition-colors"
                title="Log out"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
                  />
                </svg>
              </button>
            </.form>
          <% end %>
        </div>
      </nav>
    </div>
  </header>
<% end %>

<main class={[
  "min-h-screen text-zinc-900 dark:text-zinc-100",
  if(assigns[:hide_header] && assigns[:hide_bottom_nav],
    do: "bg-black p-0 m-0",
    else: "bg-slate-50 dark:bg-zinc-900"
  ),
  if(assigns[:hide_header], do: "pt-0", else: "pt-16"),
  if(assigns[:hide_bottom_nav], do: "pb-0", else: "pb-20 md:pb-0")
]}>
  <div class={[
    "hidden md:none absolute top-0 left-0 w-full h-16 bg-white dark:bg-zinc-900 shadow-sm border-b border-gray-100 dark:border-zinc-800 z-10 ",
    if(assigns[:hide_header], do: "hidden")
  ]}>
    {wide_layout = Map.get(assigns, :wide_layout, false)}
  </div>
  <div class={[
    "mx-auto",
    if(wide_layout, do: "w-full px-0", else: "px-0 sm:px-6 lg:px-8"),
    if(assigns[:hide_header] && assigns[:hide_bottom_nav], do: "p-0 m-0")
  ]}>
    <.flash_group flash={@flash} />
    {@inner_content}
  </div>
</main>

<!-- Global Voice Call UI Overlay -->
<%= if assigns[:active_call] do %>
  <div id="voice-call-overlay" phx-hook="VoiceCall" class="fixed inset-0 z-[120] flex items-center justify-center bg-black/80 backdrop-blur-md">
    <!-- Audio elements for ringtones -->
    <audio id="outgoing-ringtone" src="https://assets.mixkit.co/sfx/preview/mixkit-phone-ringing-bell-588.mp3" loop></audio>
    <audio id="incoming-ringtone" src="https://assets.mixkit.co/sfx/preview/mixkit-classic-short-alarm-993.mp3" loop></audio>
    
    <div class="flex flex-col items-center gap-8 p-8 text-white max-w-sm w-full">
      <div class="relative">
        <img src={@active_call.display_user.avatar_url || "/images/default_avatar.png"} class="w-32 h-32 rounded-full object-cover border-4 border-blue-500 shadow-2xl" />
        <%= if @active_call.status == :ongoing do %>
          <div class="absolute -bottom-2 -right-2 bg-green-500 p-2 rounded-full animate-pulse">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.114 5.636a9 9 0 0 1 0 12.728M16.463 8.288a5.25 5.25 0 0 1 0 7.424M6.75 8.25l4.72-4.72a.75.75 0 0 1 1.28.53v15.88a.75.75 0 0 1-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.009 9.009 0 0 1 2.25 12c0-.83.112-1.633.322-2.396C2.806 8.756 3.63 8.25 4.51 8.25H6.75Z" />
            </svg>
          </div>
        <% end %>
      </div>

      <div class="text-center">
        <h3 class="text-2xl font-bold"><%= @active_call.display_user.username %></h3>
        <p class="text-blue-200 mt-2">
          <%= case @active_call.status do %>
            <% :calling -> %> Calling...
            <% :ringing -> %> Incoming Call...
            <% :ongoing -> %> <span id="call-duration" class="font-mono text-xl">00:00</span>
          <% end %>
        </p>
      </div>

      <div class="flex items-center gap-6 mt-4">
        <%= if @active_call.status == :ringing do %>
          <button phx-click="accept_call" class="w-16 h-16 bg-green-500 rounded-full flex items-center justify-center hover:bg-green-600 transition-all shadow-lg hover:scale-105 active:scale-95">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-8 h-8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
            </svg>
          </button>
        <% end %>

        <button phx-click="decline_call" class="w-16 h-16 bg-red-500 rounded-full flex items-center justify-center hover:bg-red-600 transition-all shadow-lg hover:scale-105 active:scale-95">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-8 h-8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 0 0 5.636 5.636m12.728 12.728A9 9 0 0 1 5.636 5.636m12.728 12.728L5.636 5.636" />
          </svg>
        </button>
      </div>
    </div>
  </div>
<% end %>

<!-- Mobile bottom navigation (Instagram-style) -->
<%= unless assigns[:hide_bottom_nav] do %>
  <nav
    id="mobile-bottom-nav"
    class="fixed bottom-0 left-0 right-0 z-50 bg-white/95 dark:bg-zinc-900/95 backdrop-blur-md border-t border-gray-200 dark:border-zinc-800 md:hidden"
    style="padding-bottom: env(safe-area-inset-bottom);"
  >
    <%= if @current_user do %>
      <%!-- ============================================== --%>
      <%!-- LOGGED IN VIEW (5 Columns: Full Features)      --%>
      <%!-- ============================================== --%>
      <div class="grid grid-cols-5 h-16 items-center">
        <.link
          navigate={~p"/feed"}
          class="flex flex-col items-center justify-center h-full space-y-1 text-gray-500 hover:text-indigo-600 dark:text-gray-400 dark:hover:text-indigo-400 transition-colors group"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-6 w-6 group-hover:scale-110 transition-transform"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
            />
          </svg>
          <span class="text-[10px] font-medium">Feed</span>
        </.link>

        <.link
          navigate={~p"/chat"}
          class="relative flex flex-col items-center justify-center h-full space-y-1 text-gray-500 hover:text-indigo-600 dark:text-gray-400 dark:hover:text-indigo-400 transition-colors group messages"
        >
          <div class="relative group-hover:scale-110 transition-transform">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.88L3 20l1.88-4.745A7.972 7.972 0 013 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
              />
            </svg>
            <%= if assigns[:unread_chats_count] && @unread_chats_count > 0 do %>
              <span class="badge absolute -top-1.5 -right-2 bg-blue-600 text-white text-[10px] min-w-[16px] h-4 flex items-center justify-center rounded-full font-bold px-1 ring-2 ring-white dark:ring-zinc-900">
                {@unread_chats_count}
              </span>
            <% end %>
          </div>
          <span class="text-[10px] font-medium">Chats</span>
        </.link>

        <div class="flex items-center justify-center h-full">
          <.link
            navigate={~p"/posts/new"}
            aria-label="Create post"
            class="center-btn bg-gradient-to-br from-indigo-500 to-indigo-600 text-white w-14 h-14 rounded-full shadow-lg shadow-indigo-500/30 flex items-center justify-center transform transition-transform active:scale-95 hover:scale-105 ring-4 ring-white dark:ring-zinc-900 z-10"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-7 w-7"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 4v16m8-8H4"
              />
            </svg>
          </.link>
        </div>

        <.link
          navigate={~p"/users/settings"}
          class="flex flex-col items-center justify-center h-full space-y-1 text-gray-500 hover:text-indigo-600 dark:text-gray-400 dark:hover:text-indigo-400 transition-colors group"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-6 w-6 group-hover:scale-110 transition-transform"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
            />
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
            />
          </svg>
          <span class="text-[10px] font-medium">Settings</span>
        </.link>

        <.link
          navigate={~p"/users/#{@current_user.username}"}
          class="flex flex-col items-center justify-center h-full space-y-1 text-gray-500 hover:text-indigo-600 dark:text-gray-400 dark:hover:text-indigo-400 transition-colors group"
        >
          <div class={"h-6 w-6 rounded-full overflow-hidden border border-gray-200 dark:border-zinc-700 group-hover:border-indigo-500 transition-colors " <> VibeflowWeb.CoreComponents.avatar_frame_class(@current_user)}>
            <%= if @current_user.avatar_url do %>
              <img
                src={@current_user.avatar_url}
                alt="Profile"
                class="h-full w-full object-cover"
              />
            <% else %>
              <div class="h-full w-full bg-indigo-100 dark:bg-indigo-900/50 flex items-center justify-center text-[10px] font-bold text-indigo-600 dark:text-indigo-400">
                {String.first(@current_user.username || "?") |> String.upcase()}
              </div>
            <% end %>
          </div>
          <span class="text-[10px] font-medium">You</span>
        </.link>
      </div>
    <% else %>
      <%!-- GUEST VIEW: Centered and Closer Together --%>
      <div class="flex justify-center items-center gap-12 h-16">
        <.link
          navigate={~p"/feed"}
          class="flex flex-col items-center justify-center h-full w-16 space-y-1 text-gray-500 hover:text-indigo-600 dark:text-gray-400 dark:hover:text-indigo-400 transition-colors group"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-6 w-6 group-hover:scale-110 transition-transform"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
            />
          </svg>
          <span class="text-[10px] font-medium">Feed</span>
        </.link>

        <%!-- Vertical Divider (Optional - Remove if you want just space) --%>
        <div class="h-8 w-px bg-gray-200 dark:bg-zinc-800"></div>

        <.link
          navigate={~p"/users/log_in"}
          class="flex flex-col items-center justify-center h-full w-16 space-y-1 text-gray-500 hover:text-indigo-600 dark:text-gray-400 dark:hover:text-indigo-400 transition-colors group"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-6 h-6 group-hover:scale-110 transition-transform"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
