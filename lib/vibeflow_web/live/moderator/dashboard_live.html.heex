<div class="max-w-7xl mx-auto px-4 py-8 ">
  <h1 class="text-3xl font-bold text-gray-900 dark:text-white-100 mb-2">Moderator Dashboard</h1>
  <p class="text-gray-600 dark:text-gray-400 mb-8">Monitor and manage content across the platform</p>

  <%= if @current_user do %>
    <div class="mb-6 flex justify-between items-center">
      <div>
        <strong class="text-lg text-gray-900 dark:text-gray-100">Welcome, <%= @current_user.username %>!</strong>
        <p class="text-sm text-gray-500 dark:text-gray-400">Last login: <%= Timex.format!(Timex.now(), "%B %d, %Y at %I:%M %p", :strftime) %></p>
      </div>
      <.link navigate={~p"/feed"} class="text-blue-600 dark:text-blue-400 hover:underline text-sm font-medium">
        &larr; Back to Feed
      </.link>
    </div>
  <% end %>

  <%!-- KEY METRICS --%>
  <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
    <div class="bg-white dark:bg-zinc-900 p-6 rounded-2xl shadow-sm border border-gray-100 dark:border-zinc-800">
      <div class="flex items-center justify-between">
        <div>
          <div class="text-sm font-medium text-gray-500 dark:text-gray-400">Pending Reports</div>
          <div class="mt-2 text-3xl font-bold text-red-600 dark:text-red-400">23</div>
        </div>
        <div class="w-12 h-12 bg-red-100 dark:bg-red-900/30 rounded-full flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-red-600 dark:text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>
      </div>
    </div>

    <div class="bg-white dark:bg-zinc-900 p-6 rounded-2xl shadow-sm border border-gray-100 dark:border-zinc-800">
      <div class="flex items-center justify-between">
        <div>
          <div class="text-sm font-medium text-gray-500 dark:text-gray-400">Resolved Today</div>
          <div class="mt-2 text-3xl font-bold text-green-600 dark:text-green-400">47</div>
        </div>
        <div class="w-12 h-12 bg-green-100 dark:bg-green-900/30 rounded-full flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-green-600 dark:text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
      </div>
    </div>

    <div class="bg-white dark:bg-zinc-900 p-6 rounded-2xl shadow-sm border border-gray-100 dark:border-zinc-800">
      <div class="flex items-center justify-between">
        <div>
          <div class="text-sm font-medium text-gray-500 dark:text-gray-400">Flagged Content</div>
          <div class="mt-2 text-3xl font-bold text-indigo-600 dark:text-indigo-400">12</div>
        </div>
        <div class="w-12 h-12 bg-indigo-100 dark:bg-indigo-900/30 rounded-full flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-indigo-600 dark:text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9" />
          </svg>
        </div>
      </div>
    </div>

    <div class="bg-white dark:bg-zinc-900 p-6 rounded-2xl shadow-sm border border-gray-100 dark:border-zinc-800">
      <div class="flex items-center justify-between">
        <div>
          <div class="text-sm font-medium text-gray-500 dark:text-gray-400">Users Warned</div>
          <div class="mt-2 text-3xl font-bold text-blue-600 dark:text-blue-400">8</div>
        </div>
        <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900/30 rounded-full flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
        </div>
      </div>
    </div>
  </div>

  <%!-- RECENT ACTIVITY TIMELINE --%>
  <div class="bg-white dark:bg-zinc-900 rounded-2xl shadow-sm border border-gray-100 dark:border-zinc-800 overflow-hidden mb-8">
    <div class="px-6 py-4 border-b border-gray-100 dark:border-zinc-800">
      <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100">Recent Activity</h3>
    </div>
    <div class="p-6">
      <div class="space-y-4">
        <%!-- Action 1 --%>
        <div class="flex items-start gap-3 pb-4 border-b border-gray-100 dark:border-zinc-800 last:border-0 last:pb-0">
          <div class="w-8 h-8 bg-green-100 dark:bg-green-900/30 rounded-full flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-green-600 dark:text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <div class="flex-1">
            <p class="text-sm text-gray-900 dark:text-gray-100 font-medium">Post removed</p>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Spam content by @spammer123 - Violated community guidelines</p>
            <p class="text-xs text-gray-400 dark:text-gray-500 mt-1">15 minutes ago</p>
          </div>
        </div>

        <%!-- Action 2 --%>
        <div class="flex items-start gap-3 pb-4 border-b border-gray-100 dark:border-zinc-800 last:border-0 last:pb-0">
          <div class="w-8 h-8 bg-yellow-100 dark:bg-yellow-900/30 rounded-full flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-yellow-600 dark:text-yellow-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <div class="flex-1">
            <p class="text-sm text-gray-900 dark:text-gray-100 font-medium">User warned</p>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">@troubleuser - First warning for inappropriate comments</p>
            <p class="text-xs text-gray-400 dark:text-gray-500 mt-1">1 hour ago</p>
          </div>
        </div>

        <%!-- Action 3 --%>
        <div class="flex items-start gap-3 pb-4 border-b border-gray-100 dark:border-zinc-800 last:border-0 last:pb-0">
          <div class="w-8 h-8 bg-blue-100 dark:bg-blue-900/30 rounded-full flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
          </div>
          <div class="flex-1">
            <p class="text-sm text-gray-900 dark:text-gray-100 font-medium">Report reviewed</p>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Report #4532 - No action needed, dismissed</p>
            <p class="text-xs text-gray-400 dark:text-gray-500 mt-1">2 hours ago</p>
          </div>
        </div>

        <%!-- Action 4 --%>
        <div class="flex items-start gap-3 pb-4 border-b border-gray-100 dark:border-zinc-800 last:border-0 last:pb-0">
          <div class="w-8 h-8 bg-red-100 dark:bg-red-900/30 rounded-full flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-red-600 dark:text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
            </svg>
          </div>
          <div class="flex-1">
            <p class="text-sm text-gray-900 dark:text-gray-100 font-medium">Account suspended</p>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">@serialviolator - 7 day suspension for repeated violations</p>
            <p class="text-xs text-gray-400 dark:text-gray-500 mt-1">3 hours ago</p>
          </div>
        </div>

        <%!-- Action 5 --%>
        <div class="flex items-start gap-3">
          <div class="w-8 h-8 bg-green-100 dark:bg-green-900/30 rounded-full flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-green-600 dark:text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <div class="flex-1">
            <p class="text-sm text-gray-900 dark:text-gray-100 font-medium">Comment removed</p>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Offensive language by @badactor - User notified</p>
            <p class="text-xs text-gray-400 dark:text-gray-500 mt-1">5 hours ago</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%!-- QUICK ACTIONS --%>
  <div class="bg-white dark:bg-zinc-900 rounded-2xl shadow-sm border border-gray-100 dark:border-zinc-800 p-6">
    <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100 mb-4">Quick Actions</h3>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <.link navigate={~p"/moderator/reports"} class="flex flex-col items-center justify-center p-4 bg-gray-50 dark:bg-zinc-800 hover:bg-gray-100 dark:hover:bg-zinc-700 rounded-xl transition-colors border border-gray-200 dark:border-zinc-700">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-blue-600 dark:text-blue-400 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span class="text-sm font-medium text-gray-900 dark:text-gray-100">View All Reports</span>
      </.link>

      <button class="flex flex-col items-center justify-center p-4 bg-gray-50 dark:bg-zinc-800 hover:bg-gray-100 dark:hover:bg-zinc-700 rounded-xl transition-colors border border-gray-200 dark:border-zinc-700">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-green-600 dark:text-green-400 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <span class="text-sm font-medium text-gray-900 dark:text-gray-100">Manage Users</span>
      </button>

      <button class="flex flex-col items-center justify-center p-4 bg-gray-50 dark:bg-zinc-800 hover:bg-gray-100 dark:hover:bg-zinc-700 rounded-xl transition-colors border border-gray-200 dark:border-zinc-700">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-indigo-600 dark:text-indigo-400 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9" />
        </svg>
        <span class="text-sm font-medium text-gray-900 dark:text-gray-100">Flagged Content</span>
      </button>

      <button class="flex flex-col items-center justify-center p-4 bg-gray-50 dark:bg-zinc-800 hover:bg-gray-100 dark:hover:bg-zinc-700 rounded-xl transition-colors border border-gray-200 dark:border-zinc-700">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-purple-600 dark:text-purple-400 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
        <span class="text-sm font-medium text-gray-900 dark:text-gray-100">View Analytics</span>
      </button>
    </div>
  </div>
</div>