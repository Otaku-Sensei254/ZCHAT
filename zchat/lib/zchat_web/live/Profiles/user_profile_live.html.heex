<div class="max-w-5xl mx-auto px-4 py-8">
  <%!-- TOP NAVIGATION --%>
  <div class="flex items-center justify-between mb-6">
    <.link
      navigate={~p"/feed"}
      class="flex items-center gap-2 text-sm font-semibold text-gray-500 hover:text-orange-500 transition-colors group"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-4 w-4 group-hover:-translate-x-1 transition-transform"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      Back to Feed
    </.link>

    <%= if @current_user && @current_user.roles && Enum.any?(@current_user.roles, &(&1.name == "admin")) do %>
      <div class="flex flex-col md:flex-row gap-3">
        <.link
          navigate={~p"/admin/dashboard"}
          class="flex items-center gap-2 px-5 py-2.5 bg-orange-500 text-white text-xs font-bold uppercase tracking-wide rounded-full shadow-lg shadow-orange-500/30 hover:bg-orange-600 hover:shadow-orange-500/50 transition-all transform hover:scale-105"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
            />
          </svg>
          Admin Dashboard
        </.link>
      </div>
     
    <% end %>
  </div>

  <%!-- PROFILE CARD CONTAINER --%>
  <%!-- This creates the main white card with the subtle orange glow effect --%>
  <div class="bg-white dark:bg-zinc-900 rounded-3xl shadow-xl shadow-gray-200/50 dark:shadow-none border border-gray-100 dark:border-zinc-800 p-6 md:p-10 mb-12 relative overflow-hidden">
    <%!-- The decorative glow blob --%>
    <div class="absolute top-0 right-0 -mt-10 -mr-10 w-64 h-64 bg-orange-500/10 rounded-full blur-3xl pointer-events-none">
    </div>

    <div class="relative z-10 flex flex-col md:flex-row md:items-start justify-between gap-8">
      <%!-- LEFT: User Info --%>
      <div class="flex-1">
        <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 text-center sm:text-left">
          <%!-- Avatar with Ring --%>
          <div class="relative group">
            <%= if @user.avatar_url do %>
              <img
                src={@user.avatar_url}
                alt={@user.username}
                class="w-28 h-28 md:w-32 md:h-32 rounded-full object-cover border-4 border-white dark:border-zinc-800 shadow-lg group-hover:scale-105 transition-transform duration-300"
              />
            <% else %>
              <div class="w-28 h-28 md:w-32 md:h-32 rounded-full bg-gradient-to-br from-orange-100 to-orange-200 text-orange-600 dark:from-orange-900 dark:to-zinc-800 dark:text-orange-400 flex items-center justify-center font-bold text-4xl border-4 border-white dark:border-zinc-800 shadow-lg">
                <%= String.first(@user.username || @user.email || "?") |> String.upcase() %>
              </div>
            <% end %>
          </div>

          <%!-- Name & Handle --%>
          <div class="pt-2">
            <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 dark:text-gray-100 tracking-tight">
              <%= @user.username %>
            </h1>

            <div class="flex items-center justify-center sm:justify-start gap-3 mt-2">
              <span class="px-3 py-1 bg-gray-100 dark:bg-zinc-800 text-gray-600 dark:text-gray-400 rounded-full text-xs font-medium flex items-center gap-1">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-3 w-3"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                  />
                </svg>
                Since <%= Timex.format!(@user.inserted_at, "%b %Y", :strftime) %>
              </span>

              <%!-- Roles Badges --%>
              <%= if @current_user && @current_user.id == @user.id && @user.roles do %>
                <%= for role <- @user.roles do %>
                  <span class="px-3 py-1 text-xs font-bold uppercase tracking-wider text-blue-600 bg-blue-50 rounded-full dark:bg-blue-900/30 dark:text-blue-300 border border-blue-100 dark:border-blue-800">
                    <%= role.name %>
                  </span>
                <% end %>
              <% end %>
            </div>

            <%= if @user.bio do %>
              <p class="text-gray-600 dark:text-gray-300 text-sm mt-4 max-w-lg leading-relaxed">
                <%= @user.bio %>
              </p>
            <% end %>
          </div>
        </div>

        <%!-- Stats Row (Pills) --%>
        <div class="flex justify-center sm:justify-start gap-4 mt-8">
          <div class="px-6 py-3 bg-gray-50 dark:bg-zinc-800 rounded-2xl border border-gray-100 dark:border-zinc-700 text-center min-w-[90px]">
            <span class="block font-black text-xl text-gray-900 dark:text-white">
              <%= length(@posts) %>
            </span>
            <span class="text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
              Posts
            </span>
          </div>
          <div class="px-6 py-3 bg-gray-50 dark:bg-zinc-800 rounded-2xl border border-gray-100 dark:border-zinc-700 text-center min-w-[90px] cursor-pointer hover:bg-gray-100 dark:hover:bg-zinc-700 transition-colors">
            <span class="block font-black text-xl text-gray-900 dark:text-white">
              <%= @follow_stats.followers_count %>
            </span>
            <span class="text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
              Followers
            </span>
          </div>
          <div class="px-6 py-3 bg-gray-50 dark:bg-zinc-800 rounded-2xl border border-gray-100 dark:border-zinc-700 text-center min-w-[90px] cursor-pointer hover:bg-gray-100 dark:hover:bg-zinc-700 transition-colors">
            <span class="block font-black text-xl text-gray-900 dark:text-white">
              <%= @follow_stats.following_count %>
            </span>
            <span class="text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
              Following
            </span>
          </div>
        </div>
      </div>

      <%!-- RIGHT: Actions Buttons --%>
      <div class="flex flex-row md:flex-col gap-3 justify-center w-full md:w-auto mt-6 md:mt-2">
        <%= if @current_user.id == @user.id do %>
          <.link
            navigate={~p"/users/settings"}
            class="w-full md:w-40 px-6 py-2.5 bg-white hover:bg-gray-50 text-gray-700 font-bold rounded-full text-sm border-2 border-gray-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 dark:text-white dark:border-zinc-700 shadow-sm transition-all hover:shadow-md text-center"
          >
            Edit Profile
          </.link>
        <% else %>
          <%= if @is_following do %>
            <button
              phx-click="unfollow"
              class="w-full md:w-40 px-6 py-2.5 bg-white text-gray-700 font-bold rounded-full text-sm border-2 border-gray-200 hover:border-red-200 hover:bg-red-50 hover:text-red-600 transition-all shadow-sm dark:bg-zinc-800 dark:border-zinc-700 dark:text-white dark:hover:bg-red-900/30 dark:hover:text-red-400"
            >
              Following
            </button>
            <button 
            phx-click="message_user"
            class="w-full md:w-40 px-6 py-2.5 bg-gray-100 text-gray-700 font-bold rounded-full text-sm hover:bg-gray-200 dark:bg-blue-900/20 dark:text-blue-200 dark:hover:bg-blue-900/40 transition-colors">
              Message
            </button>
          <% else %>
            <button
              phx-click="follow"
              class="w-full md:w-40 px-6 py-2.5 bg-orange-500 text-white font-bold rounded-full text-sm hover:bg-orange-600 shadow-lg shadow-orange-500/30 hover:shadow-orange-500/50 transition-all transform hover:-translate-y-0.5"
            >
              Follow
            </button>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <%!-- POSTS SECTION --%>
  <div>
    <%!-- Tabs --%>
    <div class="flex justify-center gap-8 mb-8 border-b border-gray-200 dark:border-zinc-800">
      <div class="flex items-center gap-2 px-6 py-3 border-b-2 border-gray-900 dark:border-white text-gray-900 dark:text-white font-bold text-sm tracking-wide cursor-pointer">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"
          />
        </svg>
        POSTS
      </div>
      <div class="flex items-center gap-2 px-6 py-3 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 font-medium text-sm tracking-wide cursor-pointer transition-colors">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"
          />
        </svg>
        SAVED
      </div>
    </div>

    <%= if Enum.empty?(@posts) do %>
      <div class="bg-white dark:bg-zinc-900 rounded-2xl border-2 border-dashed border-gray-200 dark:border-zinc-700 py-24 flex flex-col items-center justify-center text-center">
        <div class="w-20 h-20 bg-gray-50 dark:bg-zinc-800 rounded-full flex items-center justify-center mb-4">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-10 w-10 text-gray-300"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
            />
          </svg>
        </div>
        <h3 class="text-lg font-bold text-gray-900 dark:text-white">No Posts Yet</h3>
        <p class="text-gray-500 text-sm mt-1">When you post photos, they will appear here.</p>
      </div>
    <% else %>
      <%!-- GRID: Increased Gap & Rounded Items --%>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        <%= for post <- @posts do %>
          <.link
            navigate={~p"/posts/#{post.id}"}
            class="relative group aspect-square bg-white dark:bg-zinc-800 cursor-pointer overflow-hidden rounded-2xl shadow-md hover:shadow-xl border border-gray-100 dark:border-zinc-700 transition-all duration-300 hover:-translate-y-1"
          >
            <%!-- Media Logic --%>
            <% media = (post.media_files || []) |> List.first()

            {url, is_video} =
              case media do
                %{"url" => url, "type" => type} ->
                  {url, String.starts_with?(type || "", "video")}

                %{"url" => url} ->
                  {url, String.ends_with?(String.downcase(url), [".mp4", ".mov"])}

                url when is_binary(url) ->
                  {url, String.ends_with?(String.downcase(url), [".mp4", ".mov"])}

                _ ->
                  {nil, false}
              end %>

            <%= if url do %>
              <%= if is_video do %>
                <video
                  src={url}
                  class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500"
                  muted
                  playsinline
                />
                <div class="absolute top-2 right-2 bg-black/50 p-1.5 rounded-full backdrop-blur-sm">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-3 w-3 text-white"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path d="M10 16.5l6-4.5-6-4.5v9zM12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z" />
                  </svg>
                </div>
              <% else %>
                <img
                  src={url}
                  alt="Post"
                  loading="lazy"
                  class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500"
                />
              <% end %>
            <% else %>
              <%!-- Text Fallback --%>
              <div class="w-full h-full flex items-center justify-center p-4 text-center bg-gradient-to-br from-gray-50 to-white dark:from-zinc-800 dark:to-zinc-900">
                <p class="text-xs font-medium text-gray-500 dark:text-gray-400 line-clamp-4 italic">
                  "<%= post.content %>"
                </p>
              </div>
            <% end %>

            <%!-- Hover Overlay: Likes & Comments --%>
            <div class="absolute inset-0 bg-black/40 backdrop-blur-[2px] flex items-center justify-center gap-8 text-white opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-4 group-hover:translate-y-0">
              <%!-- Likes Group --%>
              <div class="flex flex-col items-center gap-1">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-8 w-8 fill-white drop-shadow-md"
                  viewBox="0 0 24 24"
                >
                  <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
                </svg>
                <span class="font-bold text-lg drop-shadow-sm"><%= post.likes_count || 0 %></span>
              </div>

              <%!-- Comments Group --%>
              <div class="flex flex-col items-center gap-1">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-8 w-8 fill-white drop-shadow-md"
                  viewBox="0 0 24 24"
                >
                  <path d="M21.99 4c0-1.1-.89-2-1.99-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h14l4 4-.01-18z" />
                </svg>
                <span class="font-bold text-lg drop-shadow-sm">
                  <%= if Ecto.assoc_loaded?(post.comments), do: length(post.comments), else: 0 %>
                </span>
              </div>
            </div>
          </.link>
        <% end %>
      </div>
    <% end %>
  </div>
</div>